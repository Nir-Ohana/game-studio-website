---
// Hero.astro - Studio brand hero section for Ohana Studios
// Directly inspired by generated design mockup reference:
// Asymmetrical layout, soothing oceanic sanctuary atmosphere, tactile wooden puzzle piece badges, and senior-friendly contrast.
---

<section
  id="hero"
  class="relative overflow-hidden bg-ocean-hero border-b border-teal-500/10 pt-16 pb-20 md:pt-24 md:pb-28 px-4 sm:px-6 lg:px-8"
  aria-labelledby="hero-heading"
>
  <!-- Atmospheric Ocean Lights -->
  <div class="pointer-events-none absolute inset-0 bg-grid-subtle opacity-50" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-24 left-1/4 w-[500px] h-[500px] bg-teal-500/10 blur-[140px] rounded-full"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute top-1/2 right-10 w-[450px] h-[450px] bg-amber-500/8 blur-[130px] rounded-full"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-7xl mx-auto z-10">
    <!-- Asymmetric Two-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      
      <!-- Left Column: Editorial Studio Narrative (7 cols) -->
      <div class="lg:col-span-7 text-left space-y-8">
        
        <!-- Status Pill Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-slate-900/80 border border-teal-500/30 shadow-inner backdrop-blur-md">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-teal-400"></span>
          </span>
          <span class="text-xs sm:text-sm font-semibold text-teal-200 tracking-wide uppercase">
            Independent Game Studio &bull; Calm Games
          </span>
        </div>

        <!-- Studio Branding & Display Headline -->
        <div class="space-y-3">
          <p class="text-xs sm:text-sm font-bold tracking-widest text-teal-400/90 uppercase font-heading">
            OHANA STUDIOS
          </p>
          <h1
            id="hero-heading"
            class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.08] font-heading"
          >
            Play Together, <span class="text-gradient-seafoam">Win Together</span>
          </h1>
        </div>

        <!-- Sanctuary Manifesto Paragraph -->
        <p class="text-lg sm:text-xl text-slate-200 max-w-2xl leading-relaxed font-light">
          Ohana Studios creates a soothing sanctuary through games designed for connection, joy, and the warmth of shared family moments. Our cozy, accessible adventures invite generations to relax and play together in high-contrast comfort.
        </p>

        <!-- Tactile Action Buttons (Vercel Guidelines: min 48px hit targets, clear focus) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a
            href="/#game"
            class="inline-flex items-center justify-center gap-2.5 px-8 py-4 min-h-[48px] text-base font-bold rounded-full text-slate-950 bg-teal-400 hover:bg-teal-300 shadow-xl shadow-teal-500/25 hover:shadow-teal-500/40 transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-teal-400 focus:ring-offset-2 focus:ring-offset-[#060F17]"
          >
            <span>DISCOVER OUR GAMES</span>
            <svg class="w-5 h-5 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="/#about"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 min-h-[48px] text-base font-semibold rounded-full text-amber-200 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-400/40 hover:border-amber-400/60 shadow-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:ring-offset-2 focus:ring-offset-[#060F17]"
          >
            <span>ABOUT OHANA</span>
          </a>
        </div>

        <!-- Studio Trust / Craft Pillars -->
        <div class="flex flex-wrap items-center gap-6 pt-6 border-t border-slate-800/80">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-teal-500/10 border border-teal-500/30 flex items-center justify-center text-teal-300 flex-shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div class="text-xs text-slate-300">
              <strong class="text-white block font-heading text-sm">Senior-Friendly</strong>
              <span>50+ tested, large touch targets</span>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-300 flex-shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="text-xs text-slate-300">
              <strong class="text-white block font-heading text-sm">Zero Pressure</strong>
              <span>No timers &bull; 100% offline</span>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-teal-500/10 border border-teal-500/30 flex items-center justify-center text-teal-300 flex-shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div class="text-xs text-slate-300">
              <strong class="text-white block font-heading text-sm">Silky Smooth</strong>
              <span>Silky 60 FPS performance</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Artful Organic Showcase Card (5 cols) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-md">
          
          <!-- Decorative Floating Wooden Puzzle Pieces (As seen in image mockup) -->
          <!-- Top Right Piece -->
          <div
            class="absolute -top-6 -right-6 z-20 w-16 h-16 pointer-events-none drop-shadow-xl animate-float"
            style="animation-delay: 0.2s;"
            aria-hidden="true"
          >
            <svg viewBox="0 0 100 100" class="w-full h-full filter drop-shadow-md text-[#D9A066]">
              <path
                fill="#C68A4C"
                stroke="#8A5A2B"
                stroke-width="3"
                d="M 20,20 L 40,20 C 40,10 60,10 60,20 L 80,20 L 80,40 C 90,40 90,60 80,60 L 80,80 L 60,80 C 60,90 40,90 40,80 L 20,80 L 20,60 C 10,60 10,40 20,40 Z"
              />
            </svg>
          </div>

          <!-- Mid Left Piece -->
          <div
            class="absolute top-1/2 -left-7 z-20 w-14 h-14 pointer-events-none drop-shadow-xl animate-float"
            style="animation-delay: 1.5s;"
            aria-hidden="true"
          >
            <svg viewBox="0 0 100 100" class="w-full h-full filter drop-shadow-md">
              <path
                fill="#C68A4C"
                stroke="#8A5A2B"
                stroke-width="3"
                d="M 20,20 L 40,20 C 40,10 60,10 60,20 L 80,20 L 80,40 C 70,40 70,60 80,60 L 80,80 L 60,80 C 60,70 40,70 40,80 L 20,80 L 20,60 C 30,60 30,40 20,40 Z"
              />
            </svg>
          </div>

          <!-- Bottom Right Piece -->
          <div
            class="absolute -bottom-6 -right-5 z-20 w-16 h-16 pointer-events-none drop-shadow-xl animate-float"
            style="animation-delay: 2.8s;"
            aria-hidden="true"
          >
            <svg viewBox="0 0 100 100" class="w-full h-full filter drop-shadow-md">
              <path
                fill="#D49B5B"
                stroke="#8A5A2B"
                stroke-width="3"
                d="M 20,20 L 40,20 C 40,30 60,30 60,20 L 80,20 L 80,40 C 90,40 90,60 80,60 L 80,80 L 60,80 C 60,90 40,90 40,80 L 20,80 L 20,60 C 10,60 10,40 20,40 Z"
              />
            </svg>
          </div>

          <!-- Tactile Physical Card Container (Cream/Pearl Palette from Mockup) -->
          <div class="relative bg-[#FAF8F5] text-slate-900 rounded-[28px] p-4 sm:p-5 shadow-2xl shadow-teal-950/50 border-2 border-[#E7E2D8] transition-transform duration-300 hover:scale-[1.01]">
            
            <!-- Art Frame: Sunlit Undersea Reef with Shelly Mascot -->
            <div class="relative overflow-hidden rounded-2xl aspect-[4/3] shadow-inner mb-4 bg-[#0A2E44]">
              <img
                src="/images/games/shelly-jigsaw/sunlit-reef.png"
                alt="Sunlit coral reef undersea sanctuary"
                class="w-full h-full object-cover object-center"
                width="800"
                height="600"
                loading="eager"
              />
              <!-- Centered Swimming Shelly Mascot -->
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                <img
                  src="/images/games/shelly-jigsaw/shelly-mascot.png"
                  alt="Shelly the sea turtle mascot swimming"
                  class="w-32 sm:w-40 h-auto object-contain drop-shadow-[0_12px_24px_rgba(0,0,0,0.6)] animate-float"
                  width="160"
                  height="160"
                />
              </div>
              <!-- Subtle light sheen overlay -->
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-white/15"></div>
            </div>

            <!-- Card Content Body -->
            <div class="px-1 pt-1 pb-2 space-y-3">
              
              <!-- Section Pretitle & Counter -->
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold tracking-wider text-slate-500 uppercase font-heading">
                  ARTFUL ORGANIC SHOWCASE
                </span>
                
                <!-- Piece Counter Pill (From Mockup) -->
                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-teal-100/80 border border-teal-300/80 text-teal-900 text-xs font-mono font-bold shadow-xs">
                  <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
                  <span>14/25 Solved</span>
                </div>
              </div>

              <!-- Showcase Game Title -->
              <div>
                <h2 class="text-2xl font-black text-slate-950 font-heading tracking-tight">
                  SHELLY JIGSAW
                </h2>
                <p class="text-sm font-medium text-slate-600">
                  A relaxing coral reef adventure!
                </p>
              </div>

              <!-- Tactile Pill Badges (From Mockup) -->
              <div class="grid grid-cols-3 gap-2 pt-2 text-center">
                <div class="px-2 py-2 rounded-xl bg-[#EFECE6] border border-[#DDD8CE] text-[11px] font-bold text-slate-800 flex items-center justify-center gap-1">
                  <span>🌊</span>
                  <span>CALM &amp; COZY</span>
                </div>
                
                <div class="px-2 py-2 rounded-xl bg-[#EFECE6] border border-[#DDD8CE] text-[11px] font-bold text-slate-800 flex items-center justify-center gap-1">
                  <span>👓</span>
                  <span>SENIOR READY</span>
                </div>

                <div class="px-2 py-2 rounded-xl bg-[#EFECE6] border border-[#DDD8CE] text-[11px] font-bold text-slate-800 flex items-center justify-center gap-1">
                  <span>👨‍👩‍👧</span>
                  <span>FAMILY FUN</span>
                </div>
              </div>

            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
