---
// Hero.astro - Studio brand hero section for Ohana Studios
---

<section
  id="hero"
  class="relative overflow-hidden bg-mesh-hero border-b border-gray-800/60 pt-20 pb-24 md:pt-28 md:pb-32 px-4 sm:px-6 lg:px-8"
  aria-labelledby="hero-heading"
>
  <!-- Background Ambient Glow & Subtle Pattern -->
  <div class="pointer-events-none absolute inset-0 bg-grid-subtle opacity-40" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 sm:w-[600px] h-96 sm:h-[400px] bg-sky-500/10 blur-[120px] rounded-full"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-5xl mx-auto text-center z-10">
    <!-- Studio Status Pill Badge -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-gray-900/80 border border-sky-500/30 shadow-inner backdrop-blur-md mb-8">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-sky-400"></span>
      </span>
      <span class="text-xs sm:text-sm font-semibold text-sky-300 tracking-wide uppercase">
        Independent Game Studio
      </span>
    </div>

    <!-- Studio Title & Motto -->
    <p class="text-sm sm:text-base font-bold tracking-widest text-gray-400 uppercase mb-3 font-heading">
      OHANA STUDIOS
    </p>

    <h1
      id="hero-heading"
      class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.1] mb-6 font-heading"
    >
      Play Together, <span class="text-gradient-sky-indigo">Win Together</span>
    </h1>

    <!-- Descriptive Copy -->
    <p class="text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto mb-10 leading-relaxed font-light">
      We craft calm, thoughtful, and accessible games designed with heartfelt care for players of all ages.
      From soothing jigsaw puzzles to cooperative journeys, our games prioritize player peace, comfort, and connection.
    </p>

    <!-- Call to Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5 mb-14">
      <a
        href="/#game"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 min-h-[48px] text-base font-bold rounded-full text-slate-950 bg-gradient-to-r from-sky-400 via-sky-300 to-indigo-400 hover:from-sky-300 hover:to-indigo-300 shadow-xl shadow-sky-500/25 hover:shadow-sky-500/40 transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 focus:ring-offset-[#0B0F19]"
      >
        <span>Discover Shelly Jigsaw</span>
        <svg class="w-5 h-5 text-slate-950 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>

      <a
        href="/blog"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 min-h-[48px] text-base font-semibold rounded-full text-gray-200 bg-gray-900/80 hover:bg-gray-800 border border-gray-700/80 hover:border-gray-600 shadow-lg hover:shadow-gray-800/40 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 focus:ring-offset-[#0B0F19]"
      >
        <span>Read Devlog</span>
        <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Trust / Studio Highlights -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 max-w-4xl mx-auto pt-4 text-left">
      <div class="glass-panel p-4 rounded-xl border border-gray-800/80 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 flex-shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white font-heading">Senior-Friendly Design</h2>
          <p class="text-xs text-gray-400">High contrast, large touch targets, 50+ tested</p>
        </div>
      </div>

      <div class="glass-panel p-4 rounded-xl border border-gray-800/80 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-lg bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400 flex-shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white font-heading">Zero Ad Pressure</h2>
          <p class="text-xs text-gray-400">No pop-ups during puzzles & 100% offline-ready</p>
        </div>
      </div>

      <div class="glass-panel p-4 rounded-xl border border-gray-800/80 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 flex-shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white font-heading">Heartfelt Indie Craft</h2>
          <p class="text-xs text-gray-400">Built with Godot 4, tuned for smooth feel</p>
        </div>
      </div>
    </div>
  </div>
</section>
