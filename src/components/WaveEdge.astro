---
// A soft wave edge between two home page bands, drawn at build time from a seed.
// `from` paints the band above, `to` the band below (any CSS colour or var()).
// `flip` turns it upside down so `to` hangs from the band above instead, for a
// band that ends over the page background (from="transparent").
interface Props {
  seed: number;
  from: string;
  to: string;
  flip?: boolean;
}

const { seed, from, to, flip = false } = Astro.props;
const W = 1440;
const H = 80;
let state = seed * 7919 + 104729;
const rnd = () => (state = (state * 16807) % 2147483647) / 2147483647;

function wave(base: number, amp: number): string {
  const k1 = 1 + rnd() * 1.5;
  const k2 = 2.5 + rnd() * 2.5;
  const p1 = rnd() * Math.PI * 2;
  const p2 = rnd() * Math.PI * 2;
  const points: string[] = [];
  for (let x = 0; x <= W; x += 12) {
    const u = (x / W) * Math.PI * 2;
    const y = H * (base + amp * (0.7 * Math.sin(u * k1 + p1) + 0.3 * Math.sin(u * k2 + p2)));
    points.push(`${x} ${y.toFixed(1)}`);
  }
  return `M0 ${H} L${points.join(' L')} L${W} ${H} Z`;
}

const back = wave(0.42, 0.26);
const front = wave(0.6, 0.22);
---

<svg class:list={['wave-edge', { 'wave-edge-flip': flip }]} style={`--from: ${from}; --to: ${to}`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path class="wave-edge-back" d={back} />
  <path d={front} />
</svg>
