---
// Header.astro - Responsive sticky navigation bar for Ohana Studios
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#031422]/85 border-b border-amber-500/20 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- Studio Logo Link -->
    <a
      href="/"
      class="flex items-center gap-2.5 group transition-transform rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-400 focus:ring-offset-2 focus:ring-offset-[#031422]"
      aria-label="Ohana Studios Homepage"
    >
      <span class="font-heading font-black text-xl sm:text-2xl tracking-wide text-white group-hover:text-amber-300 transition-colors">
        OHANA <span class="text-amber-400">STUDIOS</span>
      </span>
      <span class="text-[11px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-amber-400/20 text-amber-300 border border-amber-400/40 shadow-sm hidden sm:inline-block">
        Mindful Puzzles
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main Navigation">
      <a href="/#game" class="text-sm font-bold font-heading text-sky-100 hover:text-amber-300 transition-colors py-2">
        Game
      </a>
      <a href="/blog" class="text-sm font-bold font-heading text-sky-100 hover:text-amber-300 transition-colors py-2">
        Devlog
      </a>
      <a href="mailto:contact@ohanastudios.com" class="text-sm font-bold font-heading text-sky-100 hover:text-amber-300 transition-colors py-2">
        Contact
      </a>
    </nav>

    <!-- Desktop CTA Button -->
    <div class="hidden md:flex items-center">
      <a
        href="/#game"
        class="inline-flex items-center justify-center px-5 py-2.5 min-h-[44px] text-sm font-black font-heading rounded-full text-slate-950 bg-gradient-to-r from-amber-300 via-amber-400 to-amber-500 hover:from-amber-200 hover:to-amber-400 shadow-md shadow-amber-500/25 transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:ring-offset-2 focus:ring-offset-[#031422]"
      >
        Play Shelly Jigsaw
      </a>
    </div>

    <!-- Mobile Hamburger Toggle Button -->
    <div class="flex items-center md:hidden">
      <button
        type="button"
        id="mobile-menu-button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="min-w-[44px] min-h-[44px] inline-flex items-center justify-center p-2 rounded-xl text-sky-100 hover:text-amber-300 hover:bg-slate-800/60 focus:outline-none focus:ring-2 focus:ring-amber-400 transition-colors"
      >
        <!-- Hamburger Icon -->
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close Icon -->
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Flyout Navigation Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-amber-500/20 bg-[#031422]/95 backdrop-blur-2xl px-4 pt-3 pb-6 transition-all duration-200"
    aria-label="Mobile Navigation"
  >
    <div class="flex flex-col space-y-3">
      <a href="/#game" class="mobile-nav-link min-h-[44px] flex items-center px-3 py-2.5 rounded-lg text-base font-semibold text-gray-200 hover:text-amber-300 hover:bg-slate-800/50 transition-colors">
        Game
      </a>
      <a href="/blog" class="mobile-nav-link min-h-[44px] flex items-center px-3 py-2.5 rounded-lg text-base font-semibold text-gray-200 hover:text-amber-300 hover:bg-slate-800/50 transition-colors">
        Devlog
      </a>
      <a href="mailto:contact@ohanastudios.com" class="mobile-nav-link min-h-[44px] flex items-center px-3 py-2.5 rounded-lg text-base font-semibold text-gray-200 hover:text-amber-300 hover:bg-slate-800/50 transition-colors">
        Contact
      </a>
      <div class="pt-2">
        <a
          href="/#game"
          class="mobile-nav-link flex items-center justify-center w-full min-h-[44px] px-5 py-3 text-sm font-bold rounded-full text-slate-950 bg-gradient-to-r from-amber-300 via-amber-400 to-amber-500 hover:from-amber-200 hover:to-amber-400 shadow-md shadow-amber-500/20 active:translate-y-0"
        >
          Play Shelly Jigsaw
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function initMobileMenu() {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    if (!button || !menu || !hamburgerIcon || !closeIcon) return;

    function toggleMenu(open?: boolean) {
      if (!menu || !button || !hamburgerIcon || !closeIcon) return;
      const shouldOpen = typeof open === 'boolean' ? open : menu.classList.contains('hidden');
      if (shouldOpen) {
        menu.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        button.setAttribute('aria-expanded', 'true');
      } else {
        menu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
      }
    }

    button.addEventListener('click', () => toggleMenu());

    navLinks.forEach((link) => {
      link.addEventListener('click', () => toggleMenu(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        toggleMenu(false);
        button.focus();
      }
    });
  }

  // Support both direct load and client-side page swaps
  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
