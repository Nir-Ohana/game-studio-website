---
import { STUDIO } from '../site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/#shelly-jigsaw', label: 'Our game', match: (p: string) => p === '/' },
  { href: '/blog', label: 'Devlog', match: (p: string) => p.startsWith('/blog') },
  { href: '/#contact', label: 'Contact', match: () => false },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <img src="/images/games/shelly-jigsaw/app-icon.png" alt="" width="48" height="48" />
      <span>{STUDIO}</span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((link) => (
        <a href={link.href} aria-current={link.match(path) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>
