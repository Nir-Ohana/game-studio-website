---
import { STUDIO, CONTACT_EMAIL, PRIVACY_PATH } from '../site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="card footer-card">
      <span>&copy; {year} {STUDIO}</span>
      <nav class="footer-links" aria-label="Footer">
        <a href={PRIVACY_PATH}>Privacy policy</a>
        <a href="/blog">Devlog</a>
        <a href={`mailto:${CONTACT_EMAIL}`}>Email us</a>
      </nav>
    </div>
  </div>
</footer>
