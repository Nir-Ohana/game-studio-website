---
import { STUDIO, CONTACT_EMAIL, PRIVACY_PATH } from '../site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="card footer-card">
      <a class="footer-brand" href="/">
        <img src="/images/logo-mark.webp" alt="" width="44" height="44" loading="lazy" />
        <span>{STUDIO}<small>&copy; {year}</small></span>
      </a>
      <nav class="footer-links" aria-label="Footer">
        <a href="/shelly-jigsaw/">Shelly Jigsaw</a>
        <a href="/rocket-rabbit/">Rocket Rabbit</a>
        <a href="/pili-words/">Pili Words</a>
        <a href={PRIVACY_PATH}>Shelly Jigsaw privacy policy</a>
        <a href={`mailto:${CONTACT_EMAIL}`}>Email us</a>
      </nav>
    </div>
  </div>
</footer>
