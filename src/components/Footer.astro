---
// Footer.astro - Global footer for Ohana Studios
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#0B0F19] border-t border-gray-800/80 text-gray-400">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: Studio Identity & Motto -->
      <div class="space-y-4">
        <a href="/" class="inline-block" aria-label="Ohana Studios Homepage">
          <img
            src="/images/studio/logo.svg"
            alt="Ohana Studios"
            class="h-8 w-auto object-contain"
            width="320"
            height="72"
            loading="lazy"
          />
        </a>
        <p class="text-sm font-semibold text-sky-400 tracking-wide uppercase">
          Play Together, Win Together
        </p>
        <p class="text-sm text-gray-400 leading-relaxed">
          Crafting calm, thoughtful, and accessible games that prioritize player comfort, accessibility, and heartfelt craftsmanship.
        </p>
      </div>

      <!-- Col 2: Quick Navigation Links -->
      <div class="space-y-3">
        <h2 class="text-xs font-semibold text-gray-200 tracking-wider uppercase font-heading">
          Navigation
        </h2>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/" class="hover:text-sky-400 transition-colors">
              Home
            </a>
          </li>
          <li>
            <a href="/#game" class="hover:text-sky-400 transition-colors">
              Games
            </a>
          </li>
          <li>
            <a href="/blog" class="hover:text-sky-400 transition-colors">
              Devlog & Dispatches
            </a>
          </li>
          <li>
            <a href="/#about" class="hover:text-sky-400 transition-colors">
              About Ohana Studios
            </a>
          </li>
          <li>
            <a href="/#contact" class="hover:text-sky-400 transition-colors">
              Contact & Press
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Games List -->
      <div class="space-y-3">
        <h2 class="text-xs font-semibold text-gray-200 tracking-wider uppercase font-heading">
          Our Games
        </h2>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="/#game"
              class="group flex items-center justify-between hover:text-sky-400 transition-colors"
            >
              <span>Shelly Jigsaw</span>
              <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-teal-500/10 text-teal-400 border border-teal-500/20">
                Flagship
              </span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Legal & Connect -->
      <div class="space-y-3">
        <h2 class="text-xs font-semibold text-gray-200 tracking-wider uppercase font-heading">
          Connect & Legal
        </h2>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/privacy" class="hover:text-sky-400 transition-colors">
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href="mailto:hello@ohana-studios.me"
              class="hover:text-sky-400 transition-colors"
            >
              hello@ohana-studios.me
            </a>
          </li>
          <li>
            <a
              href="https://github.com/Nir-Ohana"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-400 transition-colors inline-flex items-center gap-1.5"
            >
              <span>GitHub</span>
              <svg class="w-3.5 h-3.5 text-gray-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar: Copyright & Accessibility -->
    <div class="mt-12 pt-8 border-t border-gray-800/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500">
      <p>
        &copy; {currentYear} Ohana Studios. All rights reserved.
      </p>
      <p class="text-center sm:text-right">
        Crafted with care for players of all ages.
      </p>
    </div>
  </div>
</footer>
