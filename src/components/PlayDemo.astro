---
interface Props { title: string; src: string; name: string; intro: string; size: string; full?: boolean }
const { title, src, name, intro, size, full = false } = Astro.props;
---

<section class="section play-demo" id="play" aria-labelledby="play-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="play-title">{title}</h2>
      <p>{intro}</p>
    </div>
    <div class="play-frame" data-play-frame data-src={src} data-name={name} data-label={full ? 'game' : 'demo'}>
      <button class="btn btn-primary play-start" type="button" data-play-start>Play now</button>
      <p class="play-note">Loads about {size} the first time.</p>
    </div>
    <div class="play-actions" data-play-actions hidden>
      <button class="text-link" type="button" data-play-fullscreen>Full screen</button>
      <a class="text-link" href={src} target="_blank" rel="noopener">Open {full ? 'the game' : 'demo'} in a new tab</a>
    </div>
  </div>
</section>

<script>
  const frame = document.querySelector<HTMLElement>('[data-play-frame]');
  const start = document.querySelector<HTMLButtonElement>('[data-play-start]');
  const full = document.querySelector<HTMLButtonElement>('[data-play-fullscreen]');
  const actions = document.querySelector<HTMLElement>('[data-play-actions]');
  start?.addEventListener('click', () => {
    if (!frame) return;
    const game = document.createElement('iframe');
    game.src = frame.dataset.src ?? '';
    game.title = `${frame.dataset.name} ${frame.dataset.label ?? 'demo'}`;
    game.allow = 'fullscreen; autoplay';
    game.setAttribute('allowfullscreen', '');
    frame.replaceChildren(game);
    frame.classList.add('is-running');
    if (actions) actions.hidden = false;
    if (full) full.hidden = !game.requestFullscreen || !document.fullscreenEnabled;
    game.focus();
  });
  full?.addEventListener('click', async () => {
    try {
      await frame?.querySelector('iframe')?.requestFullscreen?.();
    } catch {
      // The adjacent new-tab link is available when full screen is declined.
      if (full) full.hidden = true;
    }
  });
</script>

<style>
  .play-frame {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 12px;
    width: min(100%, 420px, 46.125vh);
    width: min(100%, 420px, 46.125svh);
    aspect-ratio: 9 / 16;
    margin: 0 auto;
    border-radius: var(--radius-card);
    background: var(--shallows);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    text-align: center;
  }
  .play-frame.is-running { display: block; background: var(--water); }
  .play-frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .play-note { margin: 0; padding: 0 16px; color: var(--tide); font-size: 1rem; }
  .play-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 24px; margin-top: 16px; }
  .play-actions[hidden], .play-actions button[hidden] { display: none; }
  .play-actions .text-link { display: inline-flex; align-items: center; min-height: 44px; }
  .play-actions button {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--lagoon);
    font: inherit;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .play-actions button:hover { color: var(--lagoon-deep); }
</style>
