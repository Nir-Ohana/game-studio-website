---
// GameSpotlight.astro - Flagship showcase for Shelly Jigsaw: Calm Puzzles
const screenshots = [
  {
    id: "adventure",
    title: "Adventure Journey",
    subtitle: "Storybook chapter progression with Shelly the sea turtle across tropical islands",
    src: "/images/games/shelly-jigsaw/03-adventure.png",
    alt: "Shelly Jigsaw Adventure Journey screen showing chapter progress and island map",
    tag: "Adventure",
  },
  {
    id: "puzzle-play",
    title: "Piece Snapping & Board",
    subtitle: "Forgiving snap tolerances, large tactile pieces, and calm zooming controls",
    src: "/images/games/shelly-jigsaw/04-puzzle-play.png",
    alt: "Shelly Jigsaw gameplay showing jigsaw piece placement with generous snap distances",
    tag: "Gameplay",
  },
  {
    id: "daily",
    title: "Daily Puzzle",
    subtitle: "A peaceful date-seeded puzzle every morning with streak tracking and zero pressure",
    src: "/images/games/shelly-jigsaw/02-daily.png",
    alt: "Shelly Jigsaw Daily Puzzle mode displaying calendar view and gentle streak progress",
    tag: "Daily Mode",
  },
  {
    id: "completion",
    title: "Victory Stars & Journal",
    subtitle: "Warm celebrations, earned star ratings, and relaxing ambient chimes",
    src: "/images/games/shelly-jigsaw/05-completion.png",
    alt: "Shelly Jigsaw puzzle completion celebration screen showing victory stars and completion time",
    tag: "Celebration",
  },
  {
    id: "home",
    title: "Home & Levels",
    subtitle: "Clean senior-friendly menu, piece-count selector, and high-contrast UI",
    src: "/images/games/shelly-jigsaw/01-home.png",
    alt: "Shelly Jigsaw main home menu screen with accessible large buttons and level packs",
    tag: "Overview",
  },
  {
    id: "feature",
    title: "Key Art & World",
    subtitle: "Handcrafted tropical aesthetics designed for pure relaxation and mental calm",
    src: "/images/games/shelly-jigsaw/feature-graphic.png",
    alt: "Shelly Jigsaw feature graphic illustration depicting Shelly the turtle by the ocean",
    tag: "Key Art",
  },
];

const highlights = [
  {
    title: "Gentle & Forgiving",
    description: "Snapping tolerances are generously tuned so you never fight the touch screen. Pieces magnetically connect when close, and pieces never get lost.",
    icon: "sparkles",
    accent: "text-amber-400 bg-amber-500/10 border-amber-500/20",
  },
  {
    title: "Designed for 50+",
    description: "Extra-large piece modes, high-contrast borders, non-glare color palettes, and large legible fonts ensure everyone plays with comfort and ease.",
    icon: "eye",
    accent: "text-sky-400 bg-sky-500/10 border-sky-500/20",
  },
  {
    title: "Daily & Adventure Modes",
    description: "Wake up to a fresh, date-seeded daily puzzle every single morning, or journey through 50+ illustrated storybook stages alongside Shelly.",
    icon: "map",
    accent: "text-teal-400 bg-teal-500/10 border-teal-500/20",
  },
  {
    title: "Calm & Ad-Free",
    description: "Zero disruptive video ads or pop-ups during puzzle sessions. 3 free gentle hints on every single board, completely playable 100% offline.",
    icon: "shield",
    accent: "text-indigo-400 bg-indigo-500/10 border-indigo-500/20",
  },
];
---

<section
  id="game"
  class="relative py-24 sm:py-32 px-4 sm:px-6 lg:px-8 bg-[#0B0F19] overflow-hidden border-b border-gray-800/60"
  aria-labelledby="game-spotlight-heading"
>
  <!-- Ambient background glow -->
  <div class="pointer-events-none absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-teal-500/10 blur-[140px] rounded-full" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-10 right-10 w-96 h-96 bg-sky-500/10 blur-[120px] rounded-full" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Header Badge & Titles -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-300 text-xs sm:text-sm font-semibold tracking-wide uppercase mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
        <span>Flagship Release</span>
      </div>

      <h2
        id="game-spotlight-heading"
        class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight font-heading mb-5"
      >
        Shelly Jigsaw: <span class="text-gradient-amber-teal">Calm Puzzles</span>
      </h2>

      <p class="text-lg sm:text-xl text-gray-300 leading-relaxed font-light">
        Relaxing, cozy jigsaw puzzles designed for peaceful focus and comfort.
        Journey with Shelly the sea turtle through handcrafted tropical horizons, with zero stress or time limits.
      </p>
    </div>

    <!-- Interactive Screenshot Gallery -->
    <div class="mb-20" id="screenshot-gallery-container">
      <!-- Gallery Tab Selector -->
      <div
        class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-4 mb-6 scrollbar-none"
        role="tablist"
        aria-label="Game Screenshot Tabs"
      >
        {screenshots.map((item, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${item.id}`}
            aria-controls={`panel-${item.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            data-index={index}
            data-title={item.title}
            data-subtitle={item.subtitle}
            data-tag={item.tag}
            class={`gallery-tab-btn flex-shrink-0 px-4 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-sky-400 min-h-[44px] flex items-center gap-2 ${
              index === 0
                ? "bg-teal-500/20 text-teal-300 border border-teal-500/40 shadow-md shadow-teal-500/10"
                : "bg-gray-900/60 text-gray-400 border border-gray-800 hover:text-gray-200 hover:bg-gray-800/80"
            }`}
          >
            <span class="w-1.5 h-1.5 rounded-full bg-current opacity-70"></span>
            <span>{item.title}</span>
          </button>
        ))}
      </div>

      <!-- Main Showcase Frame -->
      <div class="relative max-w-5xl mx-auto rounded-2xl sm:rounded-3xl border border-gray-800 bg-gray-950/90 shadow-2xl shadow-black/80 overflow-hidden backdrop-blur-xl">
        <!-- Top Window Decorative Bar -->
        <div class="px-4 py-3 bg-gray-900/80 border-b border-gray-800/80 flex items-center justify-between text-xs text-gray-400">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/40 border border-red-500/60 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/40 border border-yellow-500/60 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/40 border border-emerald-500/60 inline-block"></span>
            <span class="ml-2 font-mono text-gray-400 font-medium hidden sm:inline">Shelly Jigsaw — Godot 4.7 Engine</span>
          </div>
          <div class="flex items-center gap-1 font-mono text-gray-400">
            <span id="gallery-counter">1</span> / <span>{screenshots.length}</span>
          </div>
        </div>

        <!-- Display Viewport Area -->
        <div class="relative bg-[#070A10] flex items-center justify-center min-h-[300px] sm:min-h-[440px] md:min-h-[520px] p-2 sm:p-6 overflow-hidden">
          {screenshots.map((item, index) => (
            <div
              id={`panel-${item.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${item.id}`}
              class={`gallery-panel w-full transition-opacity duration-300 ${
                index === 0 ? "block opacity-100" : "hidden opacity-0"
              }`}
            >
              <div class="flex flex-col items-center">
                <img
                  src={item.src}
                  alt={item.alt}
                  class="max-h-[380px] sm:max-h-[500px] md:max-h-[560px] w-auto max-w-full object-contain rounded-xl shadow-xl border border-gray-800/80"
                  loading={index === 0 ? "eager" : "lazy"}
                  width="1080"
                  height="1920"
                />
              </div>
            </div>
          ))}

          <!-- Nav Arrow Buttons -->
          <button
            type="button"
            id="gallery-prev"
            aria-label="Previous screenshot"
            class="absolute left-3 top-1/2 -translate-y-1/2 p-3 rounded-full bg-gray-900/80 hover:bg-gray-800 border border-gray-700/80 text-white shadow-xl backdrop-blur-sm transition-transform hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-sky-400 min-w-[44px] min-h-[44px] flex items-center justify-center z-20"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <button
            type="button"
            id="gallery-next"
            aria-label="Next screenshot"
            class="absolute right-3 top-1/2 -translate-y-1/2 p-3 rounded-full bg-gray-900/80 hover:bg-gray-800 border border-gray-700/80 text-white shadow-xl backdrop-blur-sm transition-transform hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-sky-400 min-w-[44px] min-h-[44px] flex items-center justify-center z-20"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

        <!-- Dynamic Caption Footer -->
        <div class="p-4 sm:p-6 bg-gray-900/90 border-t border-gray-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <h3 id="gallery-caption-title" class="text-base sm:text-lg font-bold text-white font-heading">
              {screenshots[0].title}
            </h3>
            <p id="gallery-caption-desc" class="text-xs sm:text-sm text-gray-300 mt-0.5">
              {screenshots[0].subtitle}
            </p>
          </div>
          <span
            id="gallery-caption-tag"
            class="px-3 py-1 rounded-full text-xs font-semibold bg-teal-500/10 text-teal-400 border border-teal-500/20 flex-shrink-0"
          >
            {screenshots[0].tag}
          </span>
        </div>
      </div>
    </div>

    <!-- 4 Key Feature Highlights Grid -->
    <div class="mb-20">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white font-heading mb-3">
          Designed with Care, Built for Peace
        </h3>
        <p class="text-sm sm:text-base text-gray-400">
          Every mechanic in Shelly Jigsaw is tuned to remove frustration and foster calm relaxation.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {highlights.map((h) => (
          <div class="glass-panel p-6 sm:p-8 rounded-2xl border border-gray-800/90 hover:border-gray-700/80 transition-all duration-200 group">
            <div class="flex items-start gap-4">
              <div class={`w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 border ${h.accent} transition-transform group-hover:scale-105`}>
                {h.icon === "sparkles" && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                )}
                {h.icon === "eye" && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                )}
                {h.icon === "map" && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                  </svg>
                )}
                {h.icon === "shield" && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
              </div>

              <div>
                <h4 class="text-lg font-bold text-white font-heading mb-2">
                  {h.title}
                </h4>
                <p class="text-sm text-gray-300 leading-relaxed">
                  {h.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Store Download Badges with "Coming Soon" status pills -->
    <div class="max-w-3xl mx-auto text-center p-8 sm:p-10 rounded-3xl bg-mesh-card border border-gray-800 shadow-xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 text-sky-400 text-xs font-semibold uppercase tracking-wider mb-4 border border-sky-500/20">
        Mobile Launching Soon
      </div>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white font-heading mb-3">
        Experience Shelly Jigsaw on Your Favorite Device
      </h3>
      <p class="text-sm sm:text-base text-gray-300 max-w-xl mx-auto mb-8">
        Coming soon to Google Play and the Apple App Store for smartphones and tablets.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
        <!-- Google Play Store Badge -->
        <div class="relative group w-full sm:w-auto">
          <div class="flex items-center justify-between sm:justify-start gap-4 px-6 py-3.5 rounded-2xl bg-gray-900 border border-gray-700/80 hover:border-sky-500/50 transition-all shadow-md min-w-[240px]">
            <div class="flex items-center gap-3">
              <!-- Google Play SVG Icon -->
              <svg class="w-7 h-7 flex-shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M3.609 1.814L13.792 12 3.61 22.186A2.215 2.215 0 013 20.618V3.382c0-.62.222-1.19.609-1.568z" fill="#4285F4"/>
                <path d="M17.186 8.607l-3.394 3.393 3.394 3.393 3.844-2.184c1.096-.622 1.096-1.787 0-2.418L17.186 8.607z" fill="#FBBC04"/>
                <path d="M3.609 1.814L13.792 12l3.394-3.393L6.02 2.052C5.17 1.57 4.22 1.48 3.609 1.814z" fill="#EA4335"/>
                <path d="M13.792 12L3.609 22.186c.611.334 1.561.244 2.411-.238l11.166-6.555L13.792 12z" fill="#34A853"/>
              </svg>
              <div class="text-left">
                <div class="text-[10px] uppercase font-bold tracking-wider text-gray-400">Get it on</div>
                <div class="text-sm font-extrabold text-white font-heading">Google Play</div>
              </div>
            </div>
            <!-- Coming Soon Status Pill -->
            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30 whitespace-nowrap">
              Coming Soon
            </span>
          </div>
        </div>

        <!-- Apple App Store Badge -->
        <div class="relative group w-full sm:w-auto">
          <div class="flex items-center justify-between sm:justify-start gap-4 px-6 py-3.5 rounded-2xl bg-gray-900 border border-gray-700/80 hover:border-sky-500/50 transition-all shadow-md min-w-[240px]">
            <div class="flex items-center gap-3">
              <!-- Apple SVG Icon -->
              <svg class="w-7 h-7 fill-white flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 0.92-2.87-.9.04-2 .6-2.63 1.35-.56.64-.99 1.7-0.87 2.72.99.08 1.98-.46 2.58-1.2z"/>
              </svg>
              <div class="text-left">
                <div class="text-[10px] uppercase font-bold tracking-wider text-gray-400">Download on the</div>
                <div class="text-sm font-extrabold text-white font-heading">App Store</div>
              </div>
            </div>
            <!-- Coming Soon Status Pill -->
            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30 whitespace-nowrap">
              Coming Soon
            </span>
          </div>
        </div>
      </div>

      <div class="mt-6 text-xs text-gray-400">
        Want to play early or test our Android APK? <a href="/#contact" class="text-sky-400 underline hover:text-sky-300 transition-colors">Join our playtest list</a>.
      </div>
    </div>
  </div>
</section>

<!-- Screenshot Gallery Client Interactivity -->
<script>
  function initGallery() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.gallery-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.gallery-panel');
    const prevBtn = document.getElementById('gallery-prev');
    const nextBtn = document.getElementById('gallery-next');
    const counter = document.getElementById('gallery-counter');
    const captionTitle = document.getElementById('gallery-caption-title');
    const captionDesc = document.getElementById('gallery-caption-desc');
    const captionTag = document.getElementById('gallery-caption-tag');

    if (!tabs.length || !panels.length) return;

    let currentIndex = 0;
    const total = tabs.length;

    function showIndex(index: number) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      currentIndex = index;

      // Update tabs
      tabs.forEach((tab, i) => {
        const isSelected = i === currentIndex;
        tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        if (isSelected) {
          tab.classList.remove('bg-gray-900/60', 'text-gray-400', 'border-gray-800');
          tab.classList.add('bg-teal-500/20', 'text-teal-300', 'border-teal-500/40', 'shadow-md', 'shadow-teal-500/10');
          tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          tab.classList.add('bg-gray-900/60', 'text-gray-400', 'border-gray-800');
          tab.classList.remove('bg-teal-500/20', 'text-teal-300', 'border-teal-500/40', 'shadow-md', 'shadow-teal-500/10');
        }
      });

      // Update panels
      panels.forEach((panel, i) => {
        if (i === currentIndex) {
          panel.classList.remove('hidden');
          setTimeout(() => panel.classList.remove('opacity-0'), 10);
        } else {
          panel.classList.add('opacity-0');
          panel.classList.add('hidden');
        }
      });

      // Update captions from data attributes
      const activeTab = tabs[currentIndex];
      if (activeTab) {
        const title = activeTab.getAttribute('data-title') || '';
        const subtitle = activeTab.getAttribute('data-subtitle') || '';
        const tag = activeTab.getAttribute('data-tag') || '';

        if (counter) counter.textContent = String(currentIndex + 1);
        if (captionTitle) captionTitle.textContent = title;
        if (captionDesc) captionDesc.textContent = subtitle;
        if (captionTag) captionTag.textContent = tag;
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = Number(tab.getAttribute('data-index'));
        if (!isNaN(idx)) showIndex(idx);
      });

      // Keyboard navigation for accessibility
      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowRight') {
          showIndex(currentIndex + 1);
          tabs[currentIndex]?.focus();
        } else if (e.key === 'ArrowLeft') {
          showIndex(currentIndex - 1);
          tabs[currentIndex]?.focus();
        }
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => showIndex(currentIndex - 1));
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => showIndex(currentIndex + 1));
    }
  }

  // Support direct load & client page swaps
  initGallery();
  document.addEventListener('astro:page-load', initGallery);
</script>
