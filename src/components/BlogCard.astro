---
// BlogCard.astro - Reusable post teaser card for blog archive and homepage
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, author, image, tags } = post.data;

// Format date
const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(pubDate));

// Calculate estimated read time from markdown body
const words = post.body ? post.body.trim().split(/\s+/).length : 500;
const readingTimeMinutes = Math.max(1, Math.ceil(words / 200));

const postUrl = `/blog/${post.id}`;
const fallbackImage = '/images/games/shelly-jigsaw/sunlit-reef.png';
const displayImage = image || fallbackImage;
---

<article class="sand-card group relative flex flex-col h-full rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-2xl hover:shadow-amber-500/25 hover:-translate-y-1.5">
  <!-- Cover Image Container -->
  <a href={postUrl} class="block relative aspect-[16/9] w-full overflow-hidden bg-slate-900 border-b-2 border-amber-400/30" tabindex="-1" aria-hidden="true">
    <img
      src={displayImage}
      alt={`Cover for ${title}`}
      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent opacity-60 group-hover:opacity-30 transition-opacity"></div>
    
    <!-- Primary Tag Overlay -->
    {tags && tags.length > 0 && (
      <div class="absolute top-3 left-3 z-10">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-extrabold font-heading bg-white text-sky-900 border border-amber-400 shadow-md">
          #{tags[0]}
        </span>
      </div>
    )}
  </a>

  <!-- Card Body -->
  <div class="flex flex-col flex-grow p-6 bg-white">
    <!-- Meta Info: Date & Reading Time -->
    <div class="flex items-center gap-3 text-xs font-semibold text-slate-500 mb-2.5">
      <time datetime={new Date(pubDate).toISOString()} class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>{formattedDate}</span>
      </time>
      <span class="text-slate-300">&bull;</span>
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{readingTimeMinutes} min read</span>
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-extrabold text-sky-900 font-heading group-hover:text-amber-600 transition-colors leading-snug mb-2.5">
      <a href={postUrl} class="focus:outline-none focus:underline">
        <span class="absolute inset-0 z-0"></span>
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-sm text-slate-600 leading-relaxed line-clamp-3 mb-5 flex-grow font-normal">
      {description}
    </p>

    <!-- Footer: Author & Read Link -->
    <div class="relative z-10 pt-4 border-t border-slate-100 flex items-center justify-between mt-auto">
      <span class="text-xs font-semibold text-slate-500">
        By <span class="text-sky-950 font-bold">{author}</span>
      </span>

      <span class="inline-flex items-center gap-1 text-xs font-extrabold font-heading text-sky-700 group-hover:text-amber-600 group-hover:translate-x-0.5 transition-all">
        <span>Read dispatch</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </div>
  </div>
</article>
