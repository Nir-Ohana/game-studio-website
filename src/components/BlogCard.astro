---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, image } = post.data;
const date = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(pubDate);
---

<a class="card post-card" href={`/blog/${post.id}`}>
  {image && <img src={image} alt="" width="640" height="360" loading="lazy" />}
  <span class="meta">{date}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="read">Read the post</span>
</a>
