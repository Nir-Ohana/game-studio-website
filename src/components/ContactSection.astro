---
// ContactSection.astro - Contact, Studio Info, and Community Channels for Ohana Studios
---

<section
  id="contact"
  class="relative py-24 sm:py-32 px-4 sm:px-6 lg:px-8 bg-ocean-abyss overflow-hidden"
  aria-labelledby="contact-heading"
>
  <!-- Subtle ambient gradient background -->
  <div class="pointer-events-none absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-teal-500/10 blur-[150px] rounded-full" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Section Header -->
    <div class="text-left sm:text-center max-w-2xl sm:mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-300 text-xs sm:text-sm font-semibold tracking-wide uppercase">
        <span>Say Hello</span>
      </div>

      <h2
        id="contact-heading"
        class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight font-heading"
      >
        Get in <span class="text-gradient-seafoam">Touch</span>
      </h2>

      <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-light">
        Have feedback, questions about our games, press inquiries, or just want to connect? We'd love to hear from you.
      </p>
    </div>

    <!-- Contact Grid: Primary Email Card & Studio Community Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      <!-- Card 1: Direct Email & Quick Copy (Spans 2 columns) -->
      <div class="lg:col-span-2 ocean-card p-8 sm:p-10 rounded-3xl flex flex-col justify-between shadow-xl relative overflow-hidden group">
        <div class="relative z-10">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-teal-500/10 border border-teal-500/30 flex items-center justify-center text-teal-300">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white font-heading">Direct Email</h3>
              <p class="text-xs text-slate-400">We respond to every message within 48 hours</p>
            </div>
          </div>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
            Whether you're reporting a bug, sharing warm gameplay feedback, or requesting a review copy of Shelly Jigsaw, email us directly:
          </p>

          <!-- Email Copy & Mailto Box -->
          <div class="bg-slate-950/80 rounded-2xl p-4 sm:p-5 border border-teal-500/20 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="font-mono text-sm sm:text-base font-semibold text-white selection:bg-teal-400 selection:text-slate-950">
                hello@ohana-studios.me
              </span>
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto">
              <!-- Direct Mailto Button -->
              <a
                href="mailto:hello@ohana-studios.me"
                class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-teal-400 hover:bg-teal-300 text-slate-950 font-bold text-xs sm:text-sm transition-all focus:outline-none focus:ring-2 focus:ring-teal-400 min-h-[44px] shadow-md shadow-teal-500/20"
                aria-label="Send email to hello@ohana-studios.me"
              >
                <span>Send Email</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <!-- Copy Button -->
              <button
                type="button"
                id="copy-email-button"
                class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 hover:border-teal-400/50 text-xs sm:text-sm font-semibold transition-all focus:outline-none focus:ring-2 focus:ring-teal-400 min-h-[44px]"
                aria-label="Copy email address to clipboard"
              >
                <svg id="copy-icon" class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <svg id="check-icon" class="w-4 h-4 text-teal-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span id="copy-text">Copy</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Studio Location & Mission Detail -->
        <div class="mt-8 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Independent Game Studio &bull; Based in Israel</span>
          </div>
          <div class="flex items-center gap-1.5 text-teal-300">
            <span class="w-2 h-2 rounded-full bg-teal-400"></span>
            <span>Always open to player stories &amp; ideas</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Channels & Socials (1 Column) -->
      <div class="ocean-card p-8 rounded-3xl flex flex-col justify-between shadow-xl">
        <div>
          <h3 class="text-xl font-bold text-white font-heading mb-2">Connect &amp; Follow</h3>
          <p class="text-xs text-slate-400 mb-6">Explore our open work, community, and dev updates</p>

          <div class="space-y-4">
            <!-- GitHub Link -->
            <a
              href="https://github.com/Nir-Ohana"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 rounded-2xl bg-gray-900/60 hover:bg-gray-800/80 border border-gray-800/80 hover:border-sky-500/40 transition-all group"
            >
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gray-800 flex items-center justify-center text-gray-300 group-hover:text-white transition-colors">
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-bold text-white font-heading">GitHub</div>
                  <div class="text-xs text-gray-400">@Nir-Ohana &bull; Source & dev</div>
                </div>
              </div>
              <svg class="w-4 h-4 text-gray-500 group-hover:text-sky-400 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <!-- Discord Community Link -->
            <a
              href="https://discord.gg/ohana-studios"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 rounded-2xl bg-gray-900/60 hover:bg-gray-800/80 border border-gray-800/80 hover:border-indigo-500/40 transition-all group"
            >
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-indigo-950/40 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:text-indigo-300 transition-colors">
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.894.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-bold text-white font-heading">Discord Community</div>
                  <div class="text-xs text-gray-400">Join playtesters & fans</div>
                </div>
              </div>
              <svg class="w-4 h-4 text-gray-500 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <!-- Press Inquiries -->
            <a
              href="mailto:hello@ohana-studios.me?subject=Press%20Inquiry%20-%20Ohana%20Studios"
              class="flex items-center justify-between p-4 rounded-2xl bg-gray-900/60 hover:bg-gray-800/80 border border-gray-800/80 hover:border-teal-500/40 transition-all group"
            >
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-teal-950/40 border border-teal-500/20 flex items-center justify-center text-teal-400 group-hover:text-teal-300 transition-colors">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-bold text-white font-heading">Press & Media Kit</div>
                  <div class="text-xs text-gray-400">Promo assets & interviews</div>
                </div>
              </div>
              <svg class="w-4 h-4 text-gray-500 group-hover:text-teal-400 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-800/80 text-xs text-gray-500 text-center">
          For business inquiries: <span class="text-gray-400">hello@ohana-studios.me</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Copy Email to Clipboard Script -->
<script>
  function initCopyButton() {
    const copyButton = document.getElementById('copy-email-button');
    const copyText = document.getElementById('copy-text');
    const copyIcon = document.getElementById('copy-icon');
    const checkIcon = document.getElementById('check-icon');

    if (!copyButton || !copyText || !copyIcon || !checkIcon) return;

    copyButton.addEventListener('click', async () => {
      const email = 'hello@ohana-studios.me';
      try {
        await navigator.clipboard.writeText(email);
        copyText.textContent = 'Copied!';
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        copyButton.classList.add('border-teal-500/50', 'text-teal-300');

        setTimeout(() => {
          copyText.textContent = 'Copy';
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
          copyButton.classList.remove('border-teal-500/50', 'text-teal-300');
        }, 2000);
      } catch (err) {
        // Fallback if clipboard API is blocked
        window.location.href = `mailto:${email}`;
      }
    });
  }

  initCopyButton();
  document.addEventListener('astro:page-load', initCopyButton);
</script>
