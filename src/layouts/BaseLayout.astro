---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title,
  description = "Ohana Studios crafts calm, thoughtful, and accessible games for players of all ages. Creators of Shelly Jigsaw: Calm Puzzles.",
  image = "/images/games/shelly-jigsaw/feature-graphic.png",
  canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href,
} = Astro.props;

const siteName = "Ohana Studios";
const formattedTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const resolvedImageURL = Astro.site && !image.startsWith('http')
  ? new URL(image, Astro.site).href
  : image;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#060F17" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{formattedTitle}</title>
    <meta name="title" content={formattedTitle} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImageURL} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={formattedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImageURL} />

    <!-- Google Fonts: Fredoka & Plus Jakarta Sans matching main page -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col text-white font-sans antialiased selection:bg-amber-400/30 selection:text-white relative">
    <!-- Fixed underwater reef coral & ocean background -->
    <div class="site-bg" aria-hidden="true"></div>
    <div class="site-water-caustics" aria-hidden="true"></div>

    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-5 focus:py-3 focus:bg-amber-400 focus:text-slate-950 focus:font-bold focus:rounded-full focus:shadow-xl focus:ring-2 focus:ring-amber-300"
    >
      Skip to main content
    </a>

    <!-- Navigation Header -->
    <Header />

    <!-- Main Content Slot -->
    <main id="main-content" class="flex-grow relative z-10">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />
  </body>
</html>
