---
// BlogPostLayout.astro - Reader-focused layout for blog post articles
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post?: CollectionEntry<'blog'>;
  title?: string;
  description?: string;
  pubDate?: Date | string;
  author?: string;
  image?: string;
  tags?: string[];
}

const {
  post,
  title = post?.data.title ?? 'Studio Dispatch',
  description = post?.data.description ?? '',
  pubDate = post?.data.pubDate ?? new Date(),
  author = post?.data.author ?? 'Ohana Studios',
  image = post?.data.image ?? '/images/games/shelly-jigsaw/feature-graphic.png',
  tags = post?.data.tags ?? [],
} = Astro.props;

// Date formatting
const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(pubDate));

// Reading time
const words = post?.body ? post.body.trim().split(/\s+/).length : 600;
const readingTimeMinutes = Math.max(1, Math.ceil(words / 200));
---

<BaseLayout title={title} description={description} image={image}>
  <article class="relative py-12 sm:py-16 md:py-20 px-4 sm:px-6 lg:px-8 bg-mesh-dark">
    <!-- Ambient Glow -->
    <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-sky-500/5 blur-[140px] rounded-full" aria-hidden="true"></div>

    <div class="max-w-4xl mx-auto relative z-10">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs sm:text-sm text-gray-400">
          <li>
            <a href="/" class="hover:text-sky-400 transition-colors focus:outline-none focus:underline">
              Home
            </a>
          </li>
          <li class="text-gray-600" aria-hidden="true">/</li>
          <li>
            <a href="/blog" class="hover:text-sky-400 transition-colors focus:outline-none focus:underline">
              Blog
            </a>
          </li>
          <li class="text-gray-600" aria-hidden="true">/</li>
          <li class="text-gray-200 truncate max-w-[200px] sm:max-w-md font-medium" aria-current="page">
            {title}
          </li>
        </ol>
      </nav>

      <!-- Post Header -->
      <header class="mb-10 sm:mb-12">
        <!-- Tags -->
        {tags.length > 0 && (
          <div class="flex flex-wrap items-center gap-2 mb-6">
            {tags.map((tag) => (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/20">
                #{tag}
              </span>
            ))}
          </div>
        )}

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15] mb-6 font-heading">
          {title}
        </h1>

        <!-- Subtitle / Description -->
        {description && (
          <p class="text-lg sm:text-xl text-gray-300 leading-relaxed font-light mb-8">
            {description}
          </p>
        )}

        <!-- Author & Date Metadata Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 py-4 border-y border-gray-800/80 text-sm text-gray-400">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-sky-400 to-indigo-500 flex items-center justify-center text-slate-950 font-bold text-sm font-heading shadow-md shadow-sky-500/20">
              {author.charAt(0)}
            </div>
            <div>
              <div class="font-semibold text-white font-heading">{author}</div>
              <div class="text-xs text-sky-400">Ohana Studios Team</div>
            </div>
          </div>

          <div class="flex items-center gap-4 text-xs sm:text-sm">
            <time datetime={new Date(pubDate).toISOString()} class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>{formattedDate}</span>
            </time>
            <span class="text-gray-600">&bull;</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{readingTimeMinutes} min read</span>
            </span>
          </div>
        </div>
      </header>

      <!-- Featured Hero Image -->
      {image && (
        <div class="mb-12 rounded-2xl sm:rounded-3xl overflow-hidden border border-gray-800 shadow-2xl bg-gray-950">
          <img
            src={image}
            alt={title}
            class="w-full h-auto max-h-[500px] object-cover"
            loading="eager"
          />
        </div>
      )}

      <!-- Markdown Article Content -->
      <div class="prose prose-invert prose-sky prose-lg max-w-none font-sans
                  prose-headings:font-heading prose-headings:font-bold prose-headings:text-white prose-headings:tracking-tight
                  prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4
                  prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3
                  prose-p:text-gray-300 prose-p:leading-relaxed prose-p:font-normal
                  prose-a:text-sky-400 hover:prose-a:text-sky-300 prose-a:underline-offset-4
                  prose-strong:text-white prose-strong:font-semibold
                  prose-code:text-sky-300 prose-code:bg-gray-900/80 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:border prose-code:border-gray-800
                  prose-pre:bg-gray-950/90 prose-pre:border prose-pre:border-gray-800/90 prose-pre:rounded-2xl
                  prose-img:rounded-2xl prose-img:border prose-img:border-gray-800/90 prose-img:shadow-xl
                  prose-blockquote:border-l-sky-400 prose-blockquote:bg-gray-900/40 prose-blockquote:p-4 prose-blockquote:rounded-r-xl prose-blockquote:text-gray-200
                  prose-hr:border-gray-800/80 prose-hr:my-10">
        <slot />
      </div>

      <!-- Post Footer & Author Bio Card -->
      <footer class="mt-16 pt-10 border-t border-gray-800">
        <!-- Author Bio Card -->
        <div class="glass-panel p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-gray-800 flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-12">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-sky-400 via-sky-300 to-indigo-500 flex items-center justify-center text-slate-950 font-bold text-2xl font-heading shadow-lg shadow-sky-500/25 flex-shrink-0">
            {author.charAt(0)}
          </div>
          <div class="flex-grow">
            <div class="text-xs font-semibold text-sky-400 uppercase tracking-wider mb-1">About the Author</div>
            <h2 class="text-lg font-bold text-white font-heading mb-1.5">{author} &bull; Ohana Studios</h2>
            <p class="text-sm text-gray-300 leading-relaxed font-light">
              Crafting calm, thoughtful, and accessible games for players of all ages. Building Shelly Jigsaw: Calm Puzzles with Godot 4.
            </p>
          </div>
          <div class="flex-shrink-0">
            <a
              href="/#game"
              class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold rounded-full text-slate-950 bg-gradient-to-r from-sky-400 to-indigo-400 hover:from-sky-300 hover:to-indigo-300 shadow-md shadow-sky-500/20 transition-all"
            >
              <span>Play Shelly Jigsaw</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Navigation Back to Blog -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-sm font-semibold text-sky-400 hover:text-sky-300 transition-colors focus:outline-none focus:underline"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Back to all dispatches</span>
          </a>

          <a
            href="/#contact"
            class="inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-gray-200 transition-colors"
          >
            <span>Have thoughts on this post? Contact our team</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>
