---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, author, image } = post.data;
const date = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(pubDate);
const minutes = Math.max(1, Math.ceil((post.body ?? '').trim().split(/\s+/).length / 200));
---

<BaseLayout title={title} description={description} image={image}>
  <div class="wrap">
    <a class="back-link" href="/blog">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
      All posts
    </a>
    <article class="card prose-card">
      <header class="page-head">
        <h1>{title}</h1>
        <p>{author} · {date} · {minutes} min read</p>
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
