---
import BaseLayout from './BaseLayout.astro';
import ScreenGallery from '../components/ScreenGallery.astro';
import PlayDemo from '../components/PlayDemo.astro';
import { games, type Game } from '../data/games';
import { PRIVACY_PATH } from '../site';

interface Props { game: Game }
const { game } = Astro.props;
const siteURL = Astro.site!;
const url = new URL(game.path, siteURL).href;
const otherGames = games.filter(other => other.slug !== game.slug);
const structuredData = [
  {
    '@type': 'VideoGame', '@id': `${url}#game`, name: game.name,
    url, description: game.description, image: new URL(game.icon, siteURL).href,
    genre: game.genre, gamePlatform: 'Android',
    playMode: 'https://schema.org/SinglePlayer', creativeWorkStatus: 'In development',
    inLanguage: 'en', publisher: { '@id': new URL('/#organization', siteURL).href },
    mainEntityOfPage: { '@id': `${url}#webpage` },
  },
  {
    '@type': 'BreadcrumbList', '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ohana Studios', item: siteURL.href },
      { '@type': 'ListItem', position: 2, name: game.name, item: url },
    ],
  },
];
---

<BaseLayout title={game.title} description={game.description} image={game.icon}
  imageAlt={`${game.name} app icon`} structuredData={structuredData} mainEntity={`${url}#game`}>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol><li><a href="/">Ohana Studios</a></li><li aria-current="page">{game.name}</li></ol>
    </nav>
  </div>

  <section class="hero game-page-hero" aria-labelledby="game-title">
    <div class="wrap">
      <div class="hero-copy">
        <span class="eyebrow">In development · Android</span>
        <h1 id="game-title">{game.name}</h1>
        <p class="game-tagline">{game.tagline}</p>
        <p class="lead">{game.introduction}</p>
        <div class="hero-actions">
          <a class:list={['btn', game.button]} href="#play">Play in your browser</a>
          <a class="btn btn-secondary" href="#screens">See the screenshots <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="/#contact">Contact the studio</a>
        </div>
      </div>
      <div class="phone">
        <picture>
          <source media="(max-width: 860px)" srcset={game.icon.replace('.png', '.webp')} />
          <img src={game.hero} width="540" height="1170" alt={game.heroAlt} fetchpriority="high" />
        </picture>
      </div>
    </div>
  </section>

  <PlayDemo title={`Try ${game.name}`} src={game.demo.src} name={game.name} intro={game.demo.intro} size={game.demo.size} />

  <section class="section" aria-labelledby="about-game">
    <div class="wrap game-story">
      <h2 id="about-game">{game.detailHeading}</h2>
      {game.details.map(paragraph => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section" id="screens" aria-labelledby="screens-title">
    <div class="wrap">
      <div class="section-head"><h2 id="screens-title">Inside {game.name}</h2><p>Real screenshots from the game in development.</p></div>
      <ScreenGallery screens={game.screens} />
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head"><h2 id="features-title">Made for the way you play</h2></div>
      <div class="features">
        {game.features.map(feature => <div class="card feature"><h3>{feature.title}</h3><p>{feature.text}</p></div>)}
      </div>
      {game.slug === 'shelly-jigsaw' && (
        <p class="game-note">Free to play with ads. <a href={PRIVACY_PATH}>Read Shelly Jigsaw’s privacy policy</a>.</p>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="questions-title">
    <div class="wrap">
      <div class="section-head"><h2 id="questions-title">Questions about {game.name}</h2></div>
      <div class="questions">
        {game.questions.map(item => <details class="card"><summary>{item.question}</summary><p>{item.answer}</p></details>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="more-games-title">
    <div class="wrap">
      <div class="section-head"><h2 id="more-games-title">More from Ohana Studios</h2></div>
      <div class="game-links">
        {otherGames.map(otherGame => (
          <a class="card game-link" href={otherGame.path}>
            <img src={otherGame.icon.replace('.png', '.webp')} alt="" width="64" height="64" loading="lazy" />
            <span><strong>{otherGame.name}</strong><span>{otherGame.tagline}</span></span>
            <span class="game-link-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
