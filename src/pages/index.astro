---
// index.astro - Official website for Shelly Jigsaw / Ohana Studios
// Peaceful mobile photo-jigsaw with nautical ocean theme and sun-gold accents
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shelly Jigsaw: Calm Puzzles — Official Website</title>
  <meta name="description" content="Cozy, accessible jigsaw puzzles for mobile. Curated storybook art, forgiving magnetic snapping, 3 free hints, and 100% offline play." />
  <meta name="author" content="Ohana Studios" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content="Shelly Jigsaw: Calm Puzzles" />
  <meta property="og:description" content="Peaceful jigsaw puzzles with easy-to-see pieces, gentle magnetic snapping, and zero time pressure." />
  <meta property="og:image" content="/images/games/shelly-jigsaw/feature-graphic.png" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap" rel="stylesheet" />

  <style>
    :root {
      /* Oceanic depths & tropical waters */
      --ocean-deep: #051c2c;
      --ocean-abyss: #020f1a;
      --ocean-navy: #0a324e;
      --ocean-azure: #0284c7;
      --ocean-sky: #38bdf8;
      --ocean-cyan: #06b6d4;
      --ocean-teal: #0d9488;
      --ocean-foam: #e0f2fe;
      --ocean-sand: #fef9ed;

      /* Radiant Sun Gold Accents */
      --gold-light: #fef08a;
      --gold-bright: #fde047;
      --gold-primary: #f59e0b;
      --gold-amber: #d97706;
      --gold-border: rgba(245, 158, 11, 0.45);
      --gold-glow: 0 0 35px rgba(245, 158, 11, 0.45);

      /* Living Coral Accents */
      --coral: #f43f5e;
      --coral-deep: #e11d48;

      /* UI Card and Ink Tokens */
      --card-bg: #ffffff;
      --card-border: rgba(245, 158, 11, 0.35);
      --ink: #061c2d;
      --ink-soft: #244768;
      --ink-muted: #527599;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    html, body {
      background: var(--ocean-deep);
      color: #ffffff;
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    body {
      min-height: 100vh;
      background-color: var(--ocean-deep);
      position: relative;
    }

    /* Fixed underwater reef coral & ocean background */
    .site-bg {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image: url('/images/backgrounds/reef-ocean-desktop.jpg');
      background-size: cover;
      background-position: center top;
      background-repeat: no-repeat;
    }

    @media (max-width: 640px) {
      .site-bg {
        background-image: url('/images/backgrounds/reef-ocean-mobile.jpg');
        background-position: center top;
      }
    }

    /* Soft ambient vignette & sunlit surface illumination */
    .site-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 85% 50% at 50% 0%, rgba(255, 255, 255, 0.12) 0%, transparent 65%),
        linear-gradient(180deg, rgba(2, 132, 199, 0.12) 0%, rgba(3, 19, 31, 0.22) 50%, rgba(3, 20, 34, 0.65) 100%);
    }

    /* Subtle water caustics / seafoam particles */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: radial-gradient(rgba(255, 255, 255, 0.16) 1.5px, transparent 1.5px);
      background-size: 16px 16px;
      pointer-events: none;
      z-index: 0;
    }

    /* Ambient living coral dusk glow when bottom mascot enters view */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(180deg, transparent 35%, rgba(244, 63, 94, 0.2) 75%, rgba(5, 28, 44, 0.85) 100%);
      opacity: 0;
      transition: opacity 0.6s ease;
      z-index: 0;
    }

    body.boss-visible::after {
      opacity: 1;
    }

    .wrap {
      position: relative;
      z-index: 1;
      max-width: 1180px;
      margin: 0 auto;
      padding: 32px 28px 24px;
    }

    /* Top Bar */
    .studio-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
    }

    .studio-logo {
      font-family: 'Fredoka', sans-serif;
      font-weight: 800;
      font-size: 1.25rem;
      letter-spacing: 0.5px;
      color: #ffffff;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
      transition: color 0.15s ease;
    }

    .studio-logo:hover {
      color: var(--gold-bright);
    }

    .studio-badge {
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      background: rgba(245, 158, 11, 0.18);
      border: 1.5px solid var(--gold-primary);
      padding: 3px 9px;
      border-radius: 999px;
      color: var(--gold-bright);
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.3);
    }

    .studio-nav {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .studio-nav a {
      font-family: 'Fredoka', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      color: var(--ocean-foam);
      text-decoration: none;
      transition: color 0.15s ease, text-shadow 0.15s ease;
    }

    .studio-nav a:hover {
      color: var(--gold-bright);
      text-shadow: 0 0 12px rgba(253, 224, 71, 0.6);
    }

    @media (max-width: 520px) {
      .studio-bar {
        margin-bottom: 18px;
      }
      .studio-badge {
        display: none;
      }
      .studio-nav {
        gap: 14px;
      }
      .studio-nav a {
        font-size: 0.92rem;
      }
      .wrap {
        padding: 18px 16px 20px;
      }
    }

    /* --- Hero Stage --- */
    .hero {
      text-align: center;
      padding: 12px 0 8px;
      position: relative;
    }

    .hero-stage {
      position: relative;
      max-width: 960px;
      margin: 0 auto;
      padding: 10px 0;
    }

    /* Floating Keyart */
    .keyart {
      position: absolute;
      pointer-events: none;
      filter: drop-shadow(0 12px 20px rgba(3, 19, 31, 0.4));
      will-change: transform;
    }

    .keyart-shelly-left {
      top: -4%;
      left: 3%;
      width: 22%;
      max-width: 200px;
      animation: floatA 6s ease-in-out infinite;
    }

    .keyart-piece-right {
      top: 6%;
      right: 5%;
      width: 14%;
      max-width: 120px;
      animation: floatC 6.5s ease-in-out infinite;
    }

    .keyart-star-token {
      bottom: 18%;
      left: 10%;
      width: 9%;
      max-width: 72px;
      animation: floatB 5.5s ease-in-out infinite;
    }

    @media (max-width: 640px) {
      .keyart-shelly-left {
        width: 20%;
        max-width: 80px;
        top: -6px;
        left: 2px;
      }
      .keyart-piece-right {
        width: 14%;
        max-width: 54px;
        top: 8px;
        right: 4px;
      }
      .keyart-star-token {
        display: none;
      }
    }

    @keyframes floatA {
      0%, 100% { transform: translateY(0) rotate(-6deg); }
      50%      { transform: translateY(-14px) rotate(-1deg); }
    }
    @keyframes floatB {
      0%, 100% { transform: translateY(0) rotate(-4deg); }
      50%      { transform: translateY(-10px) rotate(6deg); }
    }
    @keyframes floatC {
      0%, 100% { transform: translateY(0) rotate(8deg); }
      50%      { transform: translateY(-12px) rotate(3deg); }
    }

    .logo-tilt {
      display: block;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    .logo {
      display: block;
      margin: 0 auto 16px;
      width: 68%;
      max-width: 560px;
      height: auto;
      filter: drop-shadow(0 12px 0 rgba(3, 19, 31, 0.35)) drop-shadow(0 0 45px rgba(56, 189, 248, 0.7)) drop-shadow(0 0 75px rgba(245, 158, 11, 0.3));
      animation: float 5s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }

    .tagline {
      font-family: 'Fredoka', sans-serif;
      font-weight: 800;
      font-size: clamp(1.2rem, 2.5vw, 1.65rem);
      color: #ffffff;
      letter-spacing: 0.6px;
      margin-bottom: 24px;
      text-transform: uppercase;
      position: relative;
      z-index: 2;
      text-shadow: 0 2px 14px rgba(3, 19, 31, 0.7), 0 0 24px rgba(56, 189, 248, 0.6);
    }

    .tagline .calm-gold {
      color: var(--gold-bright);
      text-shadow: 0 0 18px rgba(253, 224, 71, 0.85);
    }

    /* --- CTA Buttons --- */
    .ctas {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 16px;
      align-items: flex-end;
      justify-content: center;
      margin-bottom: 20px;
      position: relative;
      z-index: 2;
    }

    /* Big sticker-style button - Radiant 24K Sun Gold */
    .btn-wishlist {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: min(540px, 92%);
      height: 104px;
      padding: 0 130px 0 36px;
      border-radius: 24px;
      background: linear-gradient(135deg, #fffbeb 0%, #fde047 30%, #f59e0b 80%, #d97706 100%);
      color: #061c2d;
      font-family: 'Fredoka', sans-serif;
      font-weight: 900;
      font-size: clamp(1.45rem, 3.8vw, 2.25rem);
      letter-spacing: 1px;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 0 0 3.5px #fffbeb, 0 14px 40px rgba(245, 158, 11, 0.6), 0 4px 12px rgba(3, 19, 31, 0.4);
      transition: transform 0.15s ease, filter 0.2s ease, box-shadow 0.2s ease;
      overflow: visible;
    }

    .btn-wishlist:hover {
      transform: translateY(-3px);
      filter: brightness(1.06);
      box-shadow: 0 0 0 4px #ffffff, 0 18px 52px rgba(245, 158, 11, 0.8), 0 6px 18px rgba(3, 19, 31, 0.5);
    }

    .btn-wishlist:active {
      transform: translateY(2px);
      box-shadow: 0 0 0 3px #fffbeb, 0 8px 24px rgba(245, 158, 11, 0.45);
    }

    .btn-wishlist .label {
      display: inline-flex;
      gap: 0.02em;
      white-space: nowrap;
      align-items: center;
    }

    .btn-wishlist .label span {
      display: inline-block;
      animation: letterWave 1.6s ease-in-out infinite;
    }

    .btn-wishlist .label span.space {
      display: inline-block;
      min-width: 0.36em;
    }

    @keyframes letterWave {
      0%, 100% { transform: translateY(0); }
      50%      { transform: translateY(-8px); }
    }

    .shelly-sticker {
      position: absolute;
      bottom: 8px;
      right: -14px;
      width: 142px;
      height: 120px;
      background-image: url('/images/games/shelly-jigsaw/shelly-mascot.png');
      background-repeat: no-repeat;
      background-size: contain;
      background-position: center;
      filter: drop-shadow(0 6px 12px rgba(3, 19, 31, 0.4));
      pointer-events: none;
      transform: rotate(6deg);
    }

    @media (max-width: 520px) {
      .btn-wishlist {
        height: 82px;
        padding: 0 78px 0 20px;
        font-size: clamp(1.05rem, 4.4vw, 1.35rem);
      }
      .shelly-sticker {
        width: 88px;
        height: 76px;
        right: -6px;
        bottom: 3px;
      }
    }

    @media (max-width: 380px) {
      .btn-wishlist {
        height: 74px;
        padding: 0 66px 0 16px;
        font-size: 0.96rem;
      }
      .shelly-sticker {
        width: 74px;
        height: 64px;
        right: -4px;
        bottom: 3px;
      }
    }

    .btn-stack {
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: stretch;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 13px 26px;
      border-radius: 999px;
      font-family: 'Fredoka', sans-serif;
      font-weight: 700;
      font-size: 1.05rem;
      letter-spacing: 0.5px;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .btn-discord {
      background: #5865F2;
      color: #fff;
      box-shadow: 0 8px 24px rgba(88, 101, 242, 0.45), 0 0 0 1.5px rgba(255, 255, 255, 0.3);
    }

    .btn-discord:hover {
      background: #4752c4;
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(71, 82, 196, 0.55);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.12);
      border: 2px solid rgba(56, 189, 248, 0.7);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      color: #ffffff;
      box-shadow: 0 8px 22px rgba(3, 19, 31, 0.3);
    }

    .btn-secondary:hover {
      background: rgba(56, 189, 248, 0.28);
      border-color: var(--gold-bright);
      color: var(--gold-bright);
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(56, 189, 248, 0.45);
    }

    .btn svg { width: 18px; height: 18px; }

    /* --- Featured Board / Trailer Frame --- */
    .trailer {
      position: relative;
      z-index: 1;
      max-width: 960px;
      margin: 12px auto 36px;
      padding: 0 4px;
    }

    .trailer-frame {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 22px;
      overflow: hidden;
      box-shadow: 0 20px 48px rgba(3, 19, 31, 0.6), 0 0 0 3.5px var(--gold-primary), 0 0 32px rgba(56, 189, 248, 0.35);
      background: #03131f;
      cursor: pointer;
    }

    .trailer-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }

    .trailer-frame:hover img {
      transform: scale(1.02);
    }

    .trailer-play {
      position: absolute;
      inset: 0;
      margin: auto;
      width: 82px;
      height: 56px;
      background: linear-gradient(135deg, var(--gold-primary) 0%, var(--coral) 100%);
      border: 3px solid #ffffff;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      cursor: pointer;
      box-shadow: 0 10px 28px rgba(3, 19, 31, 0.5), 0 0 22px rgba(245, 158, 11, 0.6);
      transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease;
      z-index: 2;
    }

    .trailer-play svg {
      width: 28px;
      height: 28px;
      margin-left: 3px;
      fill: currentColor;
    }

    .trailer-play:hover,
    .trailer-frame:hover .trailer-play {
      transform: scale(1.12);
      filter: brightness(1.12);
      box-shadow: 0 14px 36px rgba(244, 63, 94, 0.65), 0 0 30px rgba(253, 224, 71, 0.85);
    }

    /* --- Features Strip (Warm Sand Cards with Gold Accents) --- */
    .features {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin: 20px 0 24px;
    }

    .feature {
      background: #ffffff;
      border-radius: 20px;
      padding: 26px 22px;
      text-align: center;
      border: 2px solid rgba(245, 158, 11, 0.35);
      box-shadow: 0 12px 30px rgba(3, 19, 31, 0.28), 0 0 16px rgba(245, 158, 11, 0.12);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .feature:hover {
      transform: translateY(-4px);
      border-color: var(--gold-primary);
      box-shadow: 0 18px 36px rgba(3, 19, 31, 0.36), 0 0 24px rgba(245, 158, 11, 0.35);
    }

    .feature .icon {
      font-size: 2.3rem;
      line-height: 1;
      margin-bottom: 12px;
      display: block;
      filter: drop-shadow(0 4px 8px rgba(245, 158, 11, 0.25));
    }

    .feature h3 {
      font-family: 'Fredoka', sans-serif;
      font-weight: 800;
      color: #0369a1;
      font-size: 1.15rem;
      letter-spacing: 1px;
      margin-bottom: 8px;
      text-transform: uppercase;
    }

    .feature p {
      color: var(--ink-soft);
      font-size: 0.95rem;
      line-height: 1.5;
    }

    @media (max-width: 720px) {
      .features { grid-template-columns: 1fr; }
    }

    /* --- 2x2 Screenshot Gallery with Gold & Pearl Rims --- */
    .gallery {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      margin: 30px 0 20px;
    }

    .shot {
      position: relative;
      border-radius: 20px;
      background: #03131f;
      aspect-ratio: 16 / 9;
      cursor: zoom-in;
      overflow: hidden;
      box-shadow: 0 14px 34px rgba(3, 19, 31, 0.45), 0 0 0 3px rgba(255, 255, 255, 0.85), 0 0 0 5px rgba(245, 158, 11, 0.4);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .shot > img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 25%;
    }

    .shot:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 44px rgba(3, 19, 31, 0.6), 0 0 0 3.5px #ffffff, 0 0 0 5.5px var(--gold-primary), 0 0 25px rgba(245, 158, 11, 0.5);
    }

    @media (max-width: 600px) {
      .gallery { grid-template-columns: 1fr; }
    }

    /* --- Mascot + Bottom Callout --- */
    .boss-cta {
      position: relative;
      margin: 60px auto 10px;
      max-width: 900px;
      text-align: center;
    }

    .boss-bg {
      display: block;
      width: min(460px, 85%);
      margin: 0 auto;
      filter: drop-shadow(0 20px 35px rgba(3, 19, 31, 0.5));
      animation: bossLoom 4s ease-in-out infinite;
      transform-origin: 50% 100%;
    }

    @keyframes bossLoom {
      0%, 100% { transform: translateY(0) scale(1); }
      50%      { transform: translateY(-8px) scale(1.02); }
    }

    .ctas-bottom {
      margin-top: -36px;
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }

    /* --- Lightbox --- */
    .lightbox {
      position: fixed;
      inset: 0;
      background: rgba(3, 19, 31, 0.92);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 5vh 5vw;
      z-index: 100;
      cursor: zoom-out;
    }

    .lightbox.active { display: flex; }

    .lightbox img {
      max-width: 90%;
      max-height: 90vh;
      border-radius: 18px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
      border: 3.5px solid var(--gold-primary);
    }

    .lightbox-close {
      position: absolute;
      top: 20px;
      right: 24px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 2px solid var(--gold-primary);
      background: #ffffff;
      color: #061c2d;
      font-size: 26px;
      font-weight: 700;
      line-height: 1;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .lightbox-close:hover {
      background: var(--coral);
      border-color: #ffffff;
      color: #fff;
      transform: rotate(90deg);
    }

    /* --- Footer --- */
    footer {
      position: relative;
      z-index: 1;
      margin-top: 48px;
      padding-top: 24px;
      border-top: 2px dashed rgba(245, 158, 11, 0.35);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
      color: var(--ocean-foam);
      font-size: 0.9rem;
    }

    .footer-meta {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .studio {
      font-family: 'Fredoka', sans-serif;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: 0.5px;
      font-size: 1.05rem;
    }

    .studio span {
      color: var(--gold-bright);
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .footer-links a {
      color: var(--ocean-foam);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.85rem;
      letter-spacing: 0.02em;
      transition: color 0.15s ease;
    }

    .footer-links a:hover {
      color: var(--gold-bright);
      text-decoration: underline;
    }

    .socials { display: flex; gap: 10px; }

    .social {
      width: 42px;
      height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: #ffffff;
      color: #0284c7;
      border: 1.5px solid var(--gold-primary);
      box-shadow: 0 4px 14px rgba(3, 19, 31, 0.4), 0 0 10px rgba(245, 158, 11, 0.25);
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .social:hover {
      color: #061c2d;
      background: var(--gold-bright);
