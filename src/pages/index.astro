---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { CONTACT_EMAIL } from '../site';

const shots = '/images/games/shelly-jigsaw/screens';
const screens = [
  { src: `${shots}/home.webp`, title: 'Home', text: 'Everything one tap away.', alt: 'Shelly Jigsaw home screen with stars, shells and an Explore adventure button' },
  { src: `${shots}/adventure.webp`, title: 'Adventure', text: 'Follow Shelly from level to level.', alt: 'Adventure map with numbered levels along an underwater path' },
  { src: `${shots}/daily.webp`, title: 'Daily Challenge', text: 'A new picture every day.', alt: 'Daily Challenge screen with today’s puzzle and a weekly streak' },
  { src: `${shots}/mypuzzles.webp`, title: 'My Puzzles', text: 'Revisit the pictures you finished.', alt: 'Collection of finished puzzles with their star ratings' },
];

// Icon paths (24px, stroke) shared by the feature cards.
const features = [
  {
    title: 'Easy to read',
    text: 'Large, clear text and big buttons. An Extra large text option makes every word bigger.',
    icon: '<path d="M4 7V5h12v2M10 5v14M7 19h6M14 12v-1h6v1M17 11v8M15.5 19h3"/>',
  },
  {
    title: 'No timers, no pressure',
    text: 'Take two minutes or two days. Your puzzle waits exactly where you left it.',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  },
  {
    title: 'Pieces that help you',
    text: 'Pieces snap gently into place, and you can show just the edge pieces to start.',
    icon: '<path d="M9 3h4a2 2 0 1 1 4 0h2v6a2 2 0 1 0 0 4v6h-6a2 2 0 1 0-4 0H3v-6a2 2 0 1 1 0-4V3z"/>',
  },
  {
    title: 'Beautiful pictures',
    text: 'Hand-picked scenes of reefs, beaches and cozy places, with more on the way.',
    icon: '<rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>',
  },
  {
    title: 'A gentle hint',
    text: 'Stuck? A free hint places a piece for you. Watch a short video for more.',
    icon: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.6.6 1 1.4 1 2.5h6c0-1.1.4-1.9 1-2.5A6 6 0 0 0 12 3z"/>',
  },
  {
    title: 'Free to play',
    text: 'The game is free. Short ads appear only between puzzles, never while you play.',
    icon: '<path d="M20 12v9H4v-9M2 7h20v5H2zM12 21V7M12 7H8a2.5 2.5 0 1 1 0-5c3 0 4 5 4 5zM12 7h4a2.5 2.5 0 1 0 0-5c-3 0-4 5-4 5z"/>',
  },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Ohana Studios — Calm games for grown-ups">
  <section class="hero" id="shelly-jigsaw" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero-copy">
        <span class="eyebrow">Coming soon to Android</span>
        <h1 id="hero-title">Shelly Jigsaw</h1>
        <p class="lead">
          Calm jigsaw puzzles with big pieces, clear text and no timers. Relax with
          Shelly the sea turtle, one beautiful picture at a time.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#screens">
            See the game
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
          </a>
          <span class="store-note">Free on Google Play soon.</span>
        </div>
      </div>
      <div class="phone">
        <img src={`${shots}/home.webp`} width="540" height="1170" alt="Shelly Jigsaw home screen on a phone" />
      </div>
    </div>
  </section>

  <section class="section" id="screens" aria-labelledby="screens-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="screens-title">A peaceful place to puzzle</h2>
        <p>Real screens from the game, just as you will see them on your phone.</p>
      </div>
      <div class="screens">
        {screens.map((s) => (
          <figure class="card screen">
            <img src={s.src} alt={s.alt} width="540" height="1170" loading="lazy" />
            <figcaption>
              <strong>{s.title}</strong>
              <span>{s.text}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="features-title">Made to be comfortable</h2>
        <p>Designed with and for players over 50, and anyone who wants a quiet moment.</p>
      </div>
      <div class="features">
        {features.map((f) => (
          <div class="card feature">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
            </div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section" aria-labelledby="devlog-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="devlog-title">From our devlog</h2>
          <p>Notes on how and why we build our games.</p>
        </div>
        <div class="posts">
          {posts.map((post) => <BlogCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section" id="contact" aria-labelledby="studio-title">
    <div class="wrap split">
      <div class="card">
        <h2 id="studio-title">About Ohana Studios</h2>
        <p>
          We are a small, independent studio. <em>Ohana</em> means family, and we make games the
          whole family can enjoy: gentle, readable and never in a hurry.
        </p>
      </div>
      <div class="card">
        <h2>Say hello</h2>
        <p>Questions, ideas or a puzzle you would love to see? We read every message.</p>
        <p class="email">{CONTACT_EMAIL}</p>
        <a class="btn btn-secondary" href={`mailto:${CONTACT_EMAIL}`}>Send us an email</a>
      </div>
    </div>
  </section>
</BaseLayout>
