  <!-- Lightbox for screenshot zoom -->
  <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog">
    <button class="lightbox-close" id="lightboxClose" aria-label="Close preview">&times;</button>
    <img id="lightboxImg" src="" alt="" />
  </div>

  <script>
    // ----- 1. Logo cursor parallax (desktop only) -----
    (function () {
      const tilt = document.querySelector('.logo-tilt') as HTMLElement | null;
      if (!tilt || window.matchMedia('(hover: none)').matches) return;
      tilt.addEventListener('mousemove', (e: MouseEvent) => {
        const r = tilt.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        tilt.style.transform = `rotateX(${(-y * 12).toFixed(2)}deg) rotateY(${(x * 16).toFixed(2)}deg)`;
      });
      tilt.addEventListener('mouseleave', () => {
        tilt.style.transform = 'rotateX(0deg) rotateY(0deg)';
      });
    })();

    // ----- 2. Ambient dusk transition when bottom mascot enters view -----
    (function () {
      const boss = document.querySelector('.boss-cta');
      if (!boss || !('IntersectionObserver' in window)) return;
      new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          document.body.classList.toggle('boss-visible', e.isIntersecting);
        });
      }, { threshold: 0.35, rootMargin: '0px 0px -10% 0px' }).observe(boss);
    })();

    // ----- 3. Letter Wave animation: split label into letters with staggered delay -----
    (function () {
      document.querySelectorAll('.btn-wishlist .label').forEach((label) => {
        const text = label.textContent?.trim() || '';
        label.textContent = '';
        [...text].forEach((ch, i) => {
          const s = document.createElement('span');
          if (ch === ' ') {
            s.className = 'space';
            s.textContent = '\u00A0';
          } else {
            s.textContent = ch;
          }
          s.style.animationDelay = `${i * 0.06}s`;
          label.appendChild(s);
        });
      });
    })();

    // ----- 4. Lightbox functionality for gallery and trailer -----
    (function () {
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement | null;
      const lightboxClose = document.getElementById('lightboxClose');
      const trailerFrame = document.getElementById('trailerFrame');

      function openLightbox(src: string, alt: string) {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.setAttribute('src', src);
        lightboxImg.setAttribute('alt', alt);
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
      }

      document.querySelectorAll('.shot').forEach((shot) => {
        shot.addEventListener('click', () => {
          const img = shot.querySelector('img');
          const src = shot.getAttribute('data-src') || img?.src;
          if (src) openLightbox(src, img?.alt || 'Shelly Jigsaw Screenshot');
        });
      });

      if (trailerFrame) {
        trailerFrame.addEventListener('click', () => {
          openLightbox('/images/games/shelly-jigsaw/02-gameplay.png', 'Shelly Jigsaw Active Gameplay Board');
        });
      }

      if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
      if (lightbox) {
        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox) closeLightbox();
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      });
    })();
  </script>
