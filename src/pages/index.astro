---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveEdge from '../components/WaveEdge.astro';
import { CONTACT_EMAIL } from '../site';
import { games } from '../data/games';

const [shelly, rocket, pili] = games;
const small = (src: string) => src.replace(/\.webp$/, '-340.webp');

// Shelly's best moments, each a big icon and one short line.
const moments = [
  { title: 'Big and clear', text: 'Large pieces and text on every screen.', icon: '<path d="M4 7V5h12v2M10 5v14M7 19h6M14 12v-1h6v1M17 11v8M15.5 19h3"/>' },
  { title: 'No clock', text: 'Take two minutes or two days.', icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' },
  { title: 'A new picture daily', text: 'Pick your size. Missed days wait for you.', icon: '<rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/>' },
  { title: 'Your own photos', text: 'Turn a family photo into a puzzle.', icon: '<rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>' },
];
---

<BaseLayout title="Ohana Studios: Shelly Jigsaw, Rocket Rabbit & Pili Words">
  <section class="poster" id="games" aria-labelledby="poster-title">
    <picture class="poster-art">
      <source media="(max-width: 760px)" srcset="/images/backgrounds/lagoon-tall.webp" width="900" height="1198" />
      <img src="/images/backgrounds/lagoon-wide.webp" width="2000" height="859" alt="" fetchpriority="high" />
    </picture>
    <canvas class="poster-waves" aria-hidden="true"></canvas>
    <div class="wrap poster-inner">
      <div class="poster-copy">
        <img class="poster-icon" src={shelly.icon} width="88" height="88" alt="" />
        <h1 id="poster-title"><span>Ohana Studios presents</span> {shelly.name}</h1>
        <p class="poster-tagline">Relaxing jigsaw puzzles with big pieces and no clock.</p>
        <p class="poster-status">{shelly.status}</p>
        <ul class="store-links" aria-label={`Download ${shelly.name}`}>
          {shelly.stores?.map((store) => (
            <li><a class="btn btn-primary" href={store.href} rel="noopener">{store.label}</a></li>
          ))}
        </ul>
        <a class="text-link" href={`${shelly.path}#play`}>Play one puzzle in your browser <span aria-hidden="true">→</span></a>
      </div>
      <div class="poster-phones" aria-hidden="true">
        <div class="phone poster-phone poster-phone-back"><img src={small(shelly.screens[2].src)} width="340" height="737" alt="" /></div>
        <div class="phone poster-phone poster-phone-front"><img src={shelly.screens[1].src} width="540" height="1170" alt="" /></div>
      </div>
    </div>
  </section>

  <section class="reel" aria-labelledby="reel-title">
    <div class="wrap">
      <div class="band-head">
        <h2 id="reel-title">One lovely picture at a time</h2>
        <p>Real screens from {shelly.name}.</p>
      </div>
    </div>
    <ul class="reel-strip">
      {shelly.screens.map((screen) => (
        <li class="reel-item">
          <div class="phone"><img src={small(screen.src)} srcset={`${small(screen.src)} 340w, ${screen.src} 540w`} sizes="(max-width: 760px) 62vw, 240px" width="340" height="737" alt={screen.alt} loading="lazy" /></div>
          <span>{screen.title}</span>
        </li>
      ))}
    </ul>
    <div class="wrap">
      <ul class="moments">
        {moments.map((moment) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={moment.icon} />
            <h3>{moment.title}</h3>
            <p>{moment.text}</p>
          </li>
        ))}
      </ul>
      <a class="btn btn-secondary band-more" href={shelly.path}>Meet Shelly <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <WaveEdge seed={3} from="var(--pearl)" to="var(--rocket-sky)" />
  <section class="band band-rocket" aria-labelledby="rocket-title">
    <div class="wrap band-grid">
      <div class="band-copy">
        <img class="band-banner" src="/images/games/rocket-rabbit/feature.webp" width="1024" height="500" alt="Rocket the rabbit flies a jetpack toward a carrot on a red balloon over green pixel hills" loading="lazy" />
        <span class="band-chip">{rocket.genre} · {rocket.status}</span>
        <h2 id="rocket-title"><a href={rocket.path}>{rocket.name}</a></h2>
        <p class="band-tagline">{rocket.tagline}</p>
        <div class="band-actions">
          <a class={`btn ${rocket.button}`} href={`${rocket.path}#play`}>Play a demo</a>
          <a class="text-link" href={rocket.path}>Learn more <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="band-phones" aria-hidden="true">
        <div class="phone"><img src={small(rocket.screens[1].src)} width="340" height="737" alt="" loading="lazy" /></div>
        <div class="phone"><img src={small(rocket.screens[2].src)} width="340" height="737" alt="" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <WaveEdge seed={7} from="var(--rocket-sun)" to="var(--pili-lilac)" />
  <section class="band band-pili" aria-labelledby="pili-title">
    <div class="wrap band-grid band-grid-flip">
      <div class="band-copy">
        <img class="band-icon" src={pili.icon} width="96" height="96" alt="" loading="lazy" />
        <span class="band-chip">{pili.genre} · {pili.status}</span>
        <h2 id="pili-title"><a href={pili.path}>{pili.name}</a></h2>
        <p class="band-tagline">{pili.tagline}</p>
        <div class="band-actions">
          <a class={`btn ${pili.button}`} href={`${pili.path}#play`}>Play the first chapter</a>
          <a class="text-link" href={pili.path}>Learn more <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="band-phones" aria-hidden="true">
        <div class="phone"><img src={small(pili.screens[0].src)} width="340" height="737" alt="" loading="lazy" /></div>
        <div class="phone"><img src={small(pili.screens[2].src)} width="340" height="737" alt="" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <WaveEdge seed={11} from="var(--pili-peach)" to="var(--pearl)" />
  <section class="studio" id="contact" aria-labelledby="studio-title">
    <div class="wrap studio-grid">
      <div>
        <p class="studio-kicker">Ohana means family</p>
        <h2 id="studio-title">Small studio. Games with heart.</h2>
        <p>We make calm, friendly games for every generation.</p>
      </div>
      <div class="studio-contact">
        <h2>Say hello</h2>
        <p class="email">{CONTACT_EMAIL}</p>
        <a class="btn btn-secondary" href={`mailto:${CONTACT_EMAIL}`}>Send us an email</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Code-drawn waves along the foot of the poster: three seeded layers that drift
  // slowly. A new seed each visit; still for visitors who turn off motion.
  const canvas = document.querySelector<HTMLCanvasElement>('.poster-waves');
  const context = canvas?.getContext('2d');
  if (canvas && context) {
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const pearl = getComputedStyle(document.documentElement).getPropertyValue('--pearl').trim() || '#fffdf8';
    let seed = (Math.random() * 2 ** 31) >>> 0;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const layers = [
      { y: 0.38, amp: 0.12, colour: 'rgba(255, 253, 248, 0.45)' },
      { y: 0.6, amp: 0.1, colour: 'rgba(227, 243, 245, 0.8)' },
      { y: 0.8, amp: 0.07, colour: pearl },
    ].map((layer) => ({
      ...layer,
      k1: 1 + rnd() * 1.5, k2: 2.5 + rnd() * 2.5,
      p1: rnd() * 6.283, p2: rnd() * 6.283,
      speed: (0.08 + rnd() * 0.12) * (rnd() < 0.5 ? -1 : 1),
    }));
    let visible = true;
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }).observe(canvas);
    const draw = (time: number) => {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      const ratio = Math.min(devicePixelRatio || 1, 2);
      if (canvas.width !== Math.round(width * ratio) || canvas.height !== Math.round(height * ratio)) {
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
      }
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, width, height);
      for (const layer of layers) {
        context.beginPath();
        context.moveTo(0, height);
        for (let x = 0; x <= width + 4; x += 4) {
          const u = (x / width) * 6.283;
          const wave = 0.7 * Math.sin(u * layer.k1 + layer.p1 + time * layer.speed) + 0.3 * Math.sin(u * layer.k2 + layer.p2 - time * layer.speed * 1.6);
          context.lineTo(x, height * (layer.y + layer.amp * wave));
        }
        context.lineTo(width, height);
        context.closePath();
        context.fillStyle = layer.colour;
        context.fill();
      }
    };
    const loop = (ms: number) => {
      if (visible && !still.matches) draw(ms / 1000);
      requestAnimationFrame(loop);
    };
    draw(0);
    addEventListener('resize', () => draw(performance.now() / 1000));
    still.addEventListener('change', () => draw(performance.now() / 1000));
    requestAnimationFrame(loop);
  }
</script>
