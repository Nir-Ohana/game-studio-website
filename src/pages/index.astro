---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../site';
import { games } from '../data/games';
---

<BaseLayout title="Ohana Studios: Shelly Jigsaw, Rocket Rabbit & Pili Words">
  <section class="studio-intro" aria-labelledby="studio-intro-title">
    <div class="wrap">
      <p class="intro-kicker">Small studio. Games with heart.</p>
      <h1 id="studio-intro-title">A little calm.<br /><span>A little adventure.</span></h1>
      <p class="intro-text">A quiet puzzle by the sea. A rabbit reaching for the stars. An octopus with a way with words.<br class="desktop-break" /> We make little worlds you'll love spending time in.</p>
      <a class="intro-link text-link" href="#games">Find your next little escape <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="home-showcase" id="games" aria-labelledby="games-title">
    <div class="wrap">
      <div class="home-section-head">
        <h2 id="games-title">Three worlds. Your kind of play.</h2>
        <p>In the making. Ready to try.</p>
      </div>
      <div class="home-games">
        {games.map((game) => (
          <article class:list={['card', 'home-game', `home-game-${game.slug}`]}>
            <div class="home-game-visual">
              <span class="game-genre">{game.genre}</span>
              <a class="home-game-shot" href={game.path} tabindex="-1" aria-hidden="true">
                <img src={game.hero} width="540" height="1170" alt="" loading="lazy" />
              </a>
              <img class="home-game-icon" src={game.icon} width="80" height="80" alt="" loading="lazy" />
              <span class="game-mood">{game.mood}</span>
            </div>
            <div class="home-game-body">
              <h2><a href={game.path}>{game.name}</a></h2>
              <p>{game.tagline}</p>
              <span class="game-status">{game.status}</span>
              <div class="home-game-actions">
                <a class:list={['btn', game.button]} href={`${game.path}#play`}>{game.demo.full ? 'Play the full game' : 'Play a demo'}</a>
                <a class="text-link" href={game.path}>Learn more <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section home-contact" id="contact" aria-labelledby="studio-title">
    <div class="wrap">
      <div class="studio-note">
        <div class="studio-note-copy">
          <p class="intro-kicker">Made with heart</p>
          <h2 id="studio-title">Small studio.<br />A warm welcome.</h2>
          <p>
            We are a small, independent studio. <em>Ohana</em> means family, and we make games
            for different moments and different generations.
          </p>
        </div>
        <div class="studio-note-contact">
          <h2>Say hello</h2>
          <p class="email">{CONTACT_EMAIL}</p>
          <a class="btn btn-secondary" href={`mailto:${CONTACT_EMAIL}`}>Send us an email</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
