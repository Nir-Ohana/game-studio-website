---
// privacy.astro - Official Privacy Policy for Ohana Studios & Shelly Jigsaw: Calm Puzzles
import BaseLayout from '../layouts/BaseLayout.astro';

const effectiveDate = 'September 11, 2026';
const lastUpdated = 'September 11, 2026';
const contactEmail = 'hello@ohana-studios.me';
const websiteUrl = 'https://ohana-studios.me';
---

<BaseLayout
  title="Privacy Policy | Ohana Studios"
  description="Official Privacy Policy for Ohana Studios and Shelly Jigsaw: Calm Puzzles. Transparent, zero-collection, 100% ad-free, and COPPA compliant."
>
  <div class="relative py-12 sm:py-16 md:py-20 px-4 sm:px-6 lg:px-8 bg-mesh-dark">
    <!-- Ambient Glow Effect -->
    <div
      class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-sky-500/5 blur-[140px] rounded-full"
      aria-hidden="true"
    ></div>

    <div class="max-w-4xl mx-auto relative z-10">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs sm:text-sm text-gray-400">
          <li>
            <a
              href="/"
              class="hover:text-sky-400 transition-colors focus:outline-none focus:underline"
            >
              Home
            </a>
          </li>
          <li class="text-gray-600" aria-hidden="true">/</li>
          <li class="text-gray-200 font-medium" aria-current="page">
            Privacy Policy
          </li>
        </ol>
      </nav>

      <!-- Document Header -->
      <header class="mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-300 text-xs sm:text-sm font-semibold tracking-wide uppercase mb-6">
          <svg class="w-4 h-4 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Privacy Commitment &amp; Transparency</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15] mb-6 font-heading">
          Privacy Policy
        </h1>

        <p class="text-lg sm:text-xl text-gray-300 leading-relaxed font-light mb-8 max-w-3xl">
          At Ohana Studios, we believe games should feel like a sanctuary. We respect your peace of mind and your privacy.
          We do not collect, track, monetize, or share your personal data.
        </p>

        <!-- Metadata Pill Bar -->
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 py-4 px-5 rounded-2xl bg-gray-900/60 border border-gray-800 text-xs sm:text-sm text-gray-400">
          <div class="flex items-center gap-2">
            <span class="text-gray-500">Effective Date:</span>
            <span class="text-gray-200 font-medium">{effectiveDate}</span>
          </div>
          <span class="text-gray-700 hidden sm:inline">&bull;</span>
          <div class="flex items-center gap-2">
            <span class="text-gray-500">Last Updated:</span>
            <span class="text-gray-200 font-medium">{lastUpdated}</span>
          </div>
          <span class="text-gray-700 hidden sm:inline">&bull;</span>
          <div class="flex items-center gap-2">
            <span class="text-gray-500">Applies to:</span>
            <span class="text-sky-400 font-medium">Shelly Jigsaw &amp; Ohana Studios</span>
          </div>
        </div>
      </header>

      <!-- Privacy At A Glance Cards -->
      <section aria-labelledby="glance-heading" class="mb-16">
        <h2 id="glance-heading" class="sr-only">Privacy at a Glance</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <!-- Card 1 -->
          <div class="glass-panel p-6 rounded-2xl border border-gray-800/80 hover:border-sky-500/30 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-white font-heading mb-2">Zero Data Collection</h3>
            <p class="text-sm text-gray-300 leading-relaxed font-light">
              No accounts, no email addresses, no tracking IDs, and no telemetry. We do not gather or store any personal information.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="glass-panel p-6 rounded-2xl border border-gray-800/80 hover:border-teal-500/30 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400 mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-white font-heading mb-2">100% On-Device Storage</h3>
            <p class="text-sm text-gray-300 leading-relaxed font-light">
              Your puzzle progress, daily streaks, and settings remain solely in sandboxed storage on your device. Never uploaded to the cloud.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="glass-panel p-6 rounded-2xl border border-gray-800/80 hover:border-indigo-500/30 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-white font-heading mb-2">Zero Ads &amp; Zero Trackers</h3>
            <p class="text-sm text-gray-300 leading-relaxed font-light">
              Version 1.0 contains no third-party ad networks, no analytics SDKs, and no tracking scripts. Completely distraction-free.
            </p>
          </div>

          <!-- Card 4 -->
          <div class="glass-panel p-6 rounded-2xl border border-gray-800/80 hover:border-amber-500/30 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-white font-heading mb-2">Safe for All Ages &amp; COPPA</h3>
            <p class="text-sm text-gray-300 leading-relaxed font-light">
              Family-friendly and fully COPPA-compliant. We do not solicit or gather data from children under 13 or players of any age.
            </p>
          </div>
        </div>
      </section>

      <!-- Main Legal Prose -->
      <div class="prose prose-invert prose-sky prose-lg max-w-none font-sans
                  prose-headings:font-heading prose-headings:font-bold prose-headings:text-white prose-headings:tracking-tight
                  prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pt-8 prose-h2:border-t prose-h2:border-gray-800/80
                  prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-gray-100
                  prose-p:text-gray-300 prose-p:leading-relaxed prose-p:font-normal
                  prose-ul:text-gray-300 prose-li:my-1.5
                  prose-a:text-sky-400 hover:prose-a:text-sky-300 prose-a:underline-offset-4
                  prose-strong:text-white prose-strong:font-semibold">

        <!-- 1. Overview / Introduction -->
        <h2>1. Overview &amp; Introduction</h2>
        <p>
          Welcome to the Privacy Policy for <strong>Ohana Studios</strong> ("we", "us", or "our") and our mobile games, including our flagship title, <strong>Shelly Jigsaw: Calm Puzzles</strong> ("Shelly Jigsaw", the "Game"), as well as our official website at <a href={websiteUrl}>{websiteUrl}</a>.
        </p>
        <p>
          Ohana Studios is dedicated to designing thoughtful, soothing, and accessible digital experiences that foster relaxation and comfort for players of all ages, with special care for senior puzzle enthusiasts. We believe that gaming should be a peaceful sanctuary, not a data-harvesting machine.
        </p>
        <p>
          This Privacy Policy explains how our applications and website handle information. Our policy is straightforward: <strong>we operate on a strict zero-collection model</strong>. We do not harvest, store, share, sell, or transmit any personal data from players or visitors.
        </p>

        <!-- 2. Information We Do Not Collect -->
        <h2>2. Information We Do Not Collect</h2>
        <p>
          To provide clear and unequivocal transparency for app store review boards (including Google Play and Apple App Store) and our players, Ohana Studios explicitly affirms:
        </p>
        <ul>
          <li><strong>No Personal Data:</strong> We do not collect names, email addresses, mailing addresses, telephone numbers, age, gender, or government identification.</li>
          <li><strong>No User Accounts or Logins:</strong> You do not need an account, profile, or credentials to play Shelly Jigsaw. The game does not support or require signing in via Google, Apple ID, Facebook, email, or third-party identity providers.</li>
          <li><strong>No Advertising Identifiers or Device Fingerprinting:</strong> We do not access, request, or record Apple Identifier for Advertisers (IDFA), Google Advertising ID (GAID), Android ID, IMEI, MAC address, or any persistent hardware identifiers.</li>
          <li><strong>No Location Data:</strong> We do not collect, monitor, or track precise (GPS) or coarse (network-based) location information from your device.</li>
          <li><strong>No Gameplay Telemetry or Tracking:</strong> Version 1.0 does not transmit analytics, heatmaps, event logs, tap sequences, session lengths, or gameplay statistics to remote servers.</li>
          <li><strong>No Financial or Payment Information:</strong> Shelly Jigsaw v1 does not contain in-app purchases, paid microtransactions, or subscription billing. We process zero payment information.</li>
        </ul>

        <!-- 3. On-Device Data Storage -->
        <h2>3. On-Device Data Storage</h2>
        <p>
          Shelly Jigsaw is an offline-first game. Everything necessary for gameplay, customization, and progression is stored exclusively on your physical device within the application's private, sandboxed operating system storage (managed through Godot's isolated <code>user://</code> storage partition).
        </p>
        <p>
          The data stored locally includes:
        </p>
        <ul>
          <li><strong>Puzzle Progress:</strong> Current piece placements, completed jigsaw puzzles, and puzzle completion timestamps.</li>
          <li><strong>Game Modes &amp; Streaks:</strong> Daily puzzle calendar completions, active streak counters, and Adventure mode chapter unlock status.</li>
          <li><strong>Player Statistics:</strong> Earned stars, personal best completion times, and available hint balances.</li>
          <li><strong>User Preferences:</strong> Audio settings (background music and sound effect volumes), visual theme preferences, piece rotation toggles, and accessibility contrast adjustments.</li>
        </ul>
        <p>
          <strong>None of this data ever leaves your device.</strong> It is not synchronized to external servers, not transmitted over the internet, and not accessible to other applications or third parties.
        </p>

        <!-- 4. Advertising and Third-Party SDKs -->
        <h2>4. Advertising and Third-Party SDKs</h2>
        <p>
          Many free-to-play mobile games embed third-party Software Development Kits (SDKs) that run background trackers, profile user behaviors, and display disruptive advertisements. <strong>Ohana Studios does not engage in these practices.</strong>
        </p>
        <ul>
          <li><strong>100% Ad-Free in Version 1.0:</strong> Shelly Jigsaw contains zero banner ads, zero interstitial video popups, zero native ads, and zero rewarded video ads. Your puzzle sessions will never be interrupted by advertisements.</li>
          <li><strong>No Third-Party Analytics SDKs:</strong> We have not integrated Google Analytics for Firebase, Meta/Facebook SDK, Unity Ads, AppLovin, ironSource, AppsFlyer, Adjust, or any comparable telemetry SDKs.</li>
          <li><strong>No Social Media Trackers:</strong> No external social widgets or tracking pixels exist within our mobile game binaries.</li>
        </ul>
        <p>
          Because no network-dependent analytics or ad engines exist in the game, Shelly Jigsaw functions completely offline in airplane mode.
        </p>

        <!-- 5. Device Permissions -->
        <h2>5. Device Permissions</h2>
        <p>
          Shelly Jigsaw does not request, require, or utilize any sensitive operating system permissions on either Android or iOS. Specifically, the game does not ask for:
        </p>
        <ul>
          <li>Camera or Microphone access</li>
          <li>Contacts or Address Book access</li>
          <li>Precise or Approximate Geolocation</li>
          <li>Photo Library, Media, or External Storage access</li>
          <li>Phone State or Call Logs</li>
          <li>Bluetooth, Nearby Devices, or Local Network access</li>
        </ul>

        <!-- 6. Children's Privacy (COPPA & Global Standards) -->
        <h2>6. Children's Privacy</h2>
        <p>
          Protecting the safety and privacy of young players is of paramount importance to Ohana Studios. Shelly Jigsaw is designed as a calm, family-friendly game suitable for players of all ages, from children enjoying their first puzzles to seniors keeping their minds active.
        </p>
        <p>
          We strictly adhere to the requirements of the <strong>Children's Online Privacy Protection Act (COPPA)</strong> in the United States, the <strong>General Data Protection Regulation (GDPR / GDPR-K)</strong> in the European Union, the <strong>UK Age Appropriate Design Code</strong>, and Google Play &amp; Apple App Store Family Policies:
        </p>
        <ul>
          <li>We do not knowingly collect, solicit, or maintain personal information from children under the age of 13 (or under the age of 16 within the European Economic Area).</li>
          <li>Because our application collects zero personal information from any user regardless of age, children are protected by design.</li>
          <li>Our games do not feature behavioral profiling, personalized advertising, or unmoderated chat channels.</li>
        </ul>
        <p>
          If you are a parent or legal guardian with questions or concerns regarding our children's privacy compliance, please contact us immediately at <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
        </p>

        <!-- 7. Data Retention & Deletion -->
        <h2>7. Data Retention &amp; Deletion</h2>
        <p>
          Because Ohana Studios does not collect, receive, or store any personal data or gameplay telemetry on external servers, <strong>there is no data retained by our studio to delete</strong>.
        </p>
        <p>
          You hold 100% control over all data stored locally on your device:
        </p>
        <ul>
          <li><strong>In-App Reset:</strong> You can reset your puzzle progress, streak data, and preferences at any time from the in-game Settings menu.</li>
          <li><strong>Operating System Storage Clear:</strong> You can purge all saved data on Android by navigating to <em>Settings &gt; Apps &gt; Shelly Jigsaw &gt; Storage &gt; Clear Storage / Clear Data</em>. On iOS, you can manage application data through your device settings.</li>
          <li><strong>Uninstalling the Game:</strong> Deleting Shelly Jigsaw from your device immediately and permanently purges all local save files, progress states, and preferences.</li>
        </ul>

        <!-- 8. Website Privacy & Server Logs -->
        <h2>8. Website Privacy &amp; Server Logs</h2>
        <p>
          When you visit our studio website (<a href={websiteUrl}>{websiteUrl}</a>):
        </p>
        <ul>
          <li><strong>No Tracking Cookies:</strong> Our website is built with static HTML and CSS. We do not use tracking cookies, analytics trackers, or advertising pixels.</li>
          <li><strong>Hosting Infrastructure:</strong> Our website is statically hosted via GitHub Pages (operated by GitHub, Inc.). When you access our website, GitHub servers may process standard technical connection data (such as your IP address and user-agent string) solely for security, network transmission, and DDoS mitigation in accordance with <a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub's Privacy Statement</a>.</li>
          <li><strong>Direct Email Communications:</strong> If you choose to contact us via email at <a href={`mailto:${contactEmail}`}>{contactEmail}</a>, we will use your email address and message contents solely to respond to your inquiry. We will never sell, rent, or share your contact details for marketing or commercial purposes.</li>
        </ul>

        <!-- 9. Updates to this Policy -->
        <h2>9. Updates to this Policy</h2>
        <p>
          We may update this Privacy Policy periodically to reflect new features, operational enhancements, or statutory legal obligations. When changes occur:
        </p>
        <ul>
          <li>We will update the <strong>"Last Updated"</strong> date at the top of this policy document.</li>
          <li>The latest, authoritative version will always remain publicly available at <a href={`${websiteUrl}/privacy`}>{`${websiteUrl}/privacy`}</a>.</li>
          <li>If any future release of Shelly Jigsaw introduces optional network-based features (such as optional cloud backup of puzzle saves), we will provide advance in-app notification and update this policy prior to activation.</li>
        </ul>

        <!-- 10. Contact Information -->
        <h2>10. Contact Information</h2>
        <p>
          If you have any questions, concerns, or requests regarding this Privacy Policy or Ohana Studios' privacy practices, please contact us directly:
        </p>
      </div>

      <!-- Contact Card -->
      <div class="mt-10 glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <div class="text-xs font-semibold text-sky-400 uppercase tracking-wider mb-1">
            Privacy Inquiries &amp; Developer Contact
          </div>
          <h3 class="text-xl font-bold text-white font-heading mb-1">
            Ohana Studios
          </h3>
          <p class="text-sm text-gray-300 font-light max-w-lg mb-2">
            Developer of Shelly Jigsaw: Calm Puzzles. We respond to all privacy inquiries within 48 hours.
          </p>
          <div class="flex items-center gap-2 text-sm text-gray-400">
            <svg class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${contactEmail}`} class="text-sky-400 hover:text-sky-300 transition-colors font-medium">
              {contactEmail}
            </a>
          </div>
        </div>

        <a
          href={`mailto:${contactEmail}?subject=Privacy%20Policy%20Inquiry`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-bold text-slate-950 bg-gradient-to-r from-sky-400 to-teal-400 hover:from-sky-300 hover:to-teal-300 shadow-lg shadow-sky-500/20 transition-all focus:outline-none focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 focus:ring-offset-gray-950 flex-shrink-0"
        >
          <span>Email Privacy Team</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Back to Top / Home Navigation -->
      <div class="mt-12 pt-8 border-t border-gray-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-400">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sky-400 hover:text-sky-300 transition-colors focus:outline-none focus:underline"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          <span>Back to Ohana Studios Homepage</span>
        </a>

        <a
          href="#main-content"
          class="inline-flex items-center gap-1.5 hover:text-gray-200 transition-colors focus:outline-none focus:underline"
        >
          <span>Back to top</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
